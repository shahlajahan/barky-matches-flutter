rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && 'role' in request.auth.token
        && request.auth.token.role == 'admin';
    }

    function hasAllowedMedia() {
      return request.resource != null
        && request.resource.size <= 104857600
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp|gif|heic)|video/(mp4|quicktime|webm|hevc)'
        )
        && request.resource.name.matches(
          '.*\\.(jpg|jpeg|png|webp|gif|heic|mp4|mov|webm|hevc)$'
        );
    }

    function hasAllowedDocument() {
      return request.resource != null
        && request.resource.size <= 26214400
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp|heic)|application/pdf'
        )
        && request.resource.name.matches(
          '.*\\.(jpg|jpeg|png|webp|heic|pdf)$'
        );
    }

    function hasAllowedPetTaxiDocument() {
      return request.resource != null
        && request.resource.size <= 26214400
        && request.resource.contentType.matches(
          'image/(jpeg|png)|application/pdf'
        )
        && request.resource.name.matches(
          '.*\\.(jpg|jpeg|png|pdf)$'
        );
    }

    // Marketplace product compliance audit, P0 gap review (docs/audits/
    // marketplace_add_product_compliance_audit_2026-08-20.md): product
    // media previously reused hasAllowedMedia(), which also accepts
    // video/*. Product Storage must accept raster images only — this is
    // deliberately narrower than hasAllowedMedia() and is used ONLY by
    // the products/ and products_raw/ paths below; every other path
    // keeps hasAllowedMedia() unchanged. The exact content types and
    // extensions below are the ones add_product_page.dart's
    // _contentTypeFor()/_fileExtension() actually produce for a picked
    // still image (jpeg default, png, webp, heic/heif) — video/*,
    // image/svg+xml, text/html, and application/* are all rejected by
    // omission from the allowlist, not by a blacklist. Rules can only
    // check the client-declared contentType and the file name/extension
    // (Firebase Storage Rules cannot inspect file bytes), so both are
    // required to match together as a defense-in-depth measure against
    // a spoofed single field; this is the practical limit of what rules
    // alone can enforce against MIME spoofing.
    function hasAllowedProductImage() {
      // Extension check is written with explicit per-letter character
      // classes (not an inline (?i) flag) so it does not depend on
      // whether Firebase Storage Rules' RE2 engine honors that flag —
      // this form is unambiguous in any regex flavor and is verified by
      // the uppercase-extension tests in
      // functions/test/marketplaceProductStorageRules.test.js. Uppercase
      // extensions (e.g. Photo.JPG) are common from iOS/Android camera
      // rolls and must not be rejected purely on filename casing.
      return request.resource != null
        && request.resource.size <= 10485760
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp', 'image/heic'
        ]
        && request.resource.name.matches(
          '.*\\.([jJ][pP][gG]|[jJ][pP][eE][gG]|[pP][nN][gG]'
          + '|[wW][eE][bB][pP]|[hH][eE][iI][cC]|[hH][eE][iI][fF])$'
        );
    }

    // Business gallery and cover media. business_gallery/ and
    // business_cover/ previously had no matching rule at all and fell
    // through to the deny-all at the bottom of this file, so every existing
    // Vet / Groomy / Pet Hotel dashboard gallery upload and the Vet cover
    // image were rejected in production. These two validators restore both
    // paths under the same owner-bound model products/ already uses.
    //
    // hasAllowedBusinessImage() is shared by the flat business_gallery/
    // object path and by business_cover/: both receive exactly one
    // ImageUploadService-produced still image per object, with identical
    // compression, naming and content-type contracts, so a single validator
    // is accurate rather than merely convenient. It is actor-agnostic — it
    // constrains the object only — and authorization stays in each match
    // block.
    //
    // They are deliberately split by object shape rather than reusing
    // hasAllowedMedia(): the flat business_gallery/{businessId}/{fileName}
    // path only ever receives still images (ImageUploadService re-encodes
    // to JPEG; the Vet gallery page picks a still), and the nested
    // business_gallery/{businessId}/videos/{fileName} path only ever
    // receives video. Using one combined validator would let video be
    // written to the image path and images to the videos/ path; splitting
    // keeps each namespace to exactly the media kind its callers produce.
    //
    // As with hasAllowedProductImage() above, Storage Rules cannot inspect
    // file bytes — only the client-declared contentType and the object
    // name are available — so both are required to agree as defense in
    // depth against a single spoofed field. Extension checks use explicit
    // per-letter character classes rather than an inline (?i) flag so they
    // do not depend on whether the RE2 engine honors that flag; uppercase
    // extensions are common from iOS/Android camera rolls.
    function hasAllowedBusinessImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10485760
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'image/webp', 'image/heic'
        ]
        && request.resource.name.matches(
          '.*\\.([jJ][pP][gG]|[jJ][pP][eE][gG]|[pP][nN][gG]'
          + '|[wW][eE][bB][pP]|[hH][eE][iI][cC])$'
        );
    }

    // The 100 MiB ceiling here matches hasAllowedMedia(), which is the
    // established limit for every other video-bearing path in this file
    // (stories/, dogs/, social_posts/, adoption_center sector docs). The
    // 10 MiB product-image limit is not applicable to video and is kept
    // for the image validator above only. The accepted content types and
    // extensions are exactly the four the dashboards' own _isVideo()
    // gate plus the repo's existing adoptionContentTypeFor() mapping
    // produce; image/gif is deliberately excluded from both validators.
    function hasAllowedBusinessGalleryVideo() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 104857600
        && request.resource.contentType in [
          'video/mp4', 'video/quicktime', 'video/webm', 'video/hevc'
        ]
        && request.resource.name.matches(
          '.*\\.([mM][pP]4|[mM][oO][vV]|[wW][eE][bB][mM]|[hH][eE][vV][cC])$'
        );
    }

    function isBusinessOwner(businessId) {
      return isSignedIn()
        && businessId is string
        && firestore.get(
          /databases/(default)/documents/businesses/$(businessId)
        ).data.ownerUid == request.auth.uid;
    }

    match /adoption_requests_uploads/{userId}/{allPaths=**} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && hasAllowedDocument();
      allow delete: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
    }

    match /business_sector_docs/{ownerOrBusinessId}/adoption_center/{allPaths=**} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == ownerOrBusinessId ||
          isBusinessOwner(ownerOrBusinessId) ||
          isAdmin()
        );
      allow create, update: if isSignedIn()
        && (
          request.auth.uid == ownerOrBusinessId ||
          isBusinessOwner(ownerOrBusinessId) ||
          isAdmin()
        )
        && hasAllowedMedia();
      allow delete: if isSignedIn()
        && (
          request.auth.uid == ownerOrBusinessId ||
          isBusinessOwner(ownerOrBusinessId) ||
          isAdmin()
        );
    }

    match /business_sector_docs/{ownerUid}/pet_taxi/{allPaths=**} {
      allow read: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin());
      allow create, update: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin())
        && hasAllowedPetTaxiDocument();
      allow delete: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin());
    }

    match /business_sector_docs/{ownerUid}/{sector}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == ownerUid;
      allow create, update: if isSignedIn()
        && request.auth.uid == ownerUid
        && hasAllowedDocument();
      allow delete: if isSignedIn() && request.auth.uid == ownerUid;
    }

    match /business_docs/{ownerUid}/{allPaths=**} {
      allow read: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin());
      allow create, update: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin())
        && hasAllowedDocument();
      allow delete: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin());
    }

    match /stories/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && hasAllowedMedia();
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{allPaths=**} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn()
        && (request.auth.uid == userId || isAdmin())
        && hasAllowedMedia();
      allow delete: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
    }

    match /dogs/{ownerUid}/{allPaths=**} {
      allow read: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin());
      allow create, update: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin())
        && hasAllowedMedia();
      allow delete: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin());
    }

    match /social_posts/{userId}/{postId}/{allPaths=**} {
      allow read: if resource.metadata.visibility == 'public'
        || (request.auth != null && request.auth.uid == userId)
        || isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && hasAllowedMedia();
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Marketplace product images, P0 remediation
    // (docs/audits/marketplace_add_product_compliance_audit_2026-08-20.md,
    // finding F-08 — these paths previously had no matching rule at all and
    // fell through to the deny-all below). Read/write is scoped to the
    // owning business (matching the existing dogs/, stories/, and
    // users/{uid}/profile/ pattern in this file) plus admins; only
    // raster product images are accepted (hasAllowedProductImage(), not
    // hasAllowedMedia() — see its definition above). KNOWN GAP: the
    // Flutter client (_uploadMedia() in add_product_page.dart) can still
    // pick and attempt to upload video for a product; that upload will
    // now be rejected here. Video product media is not supported until a
    // dedicated, reviewed video validator is designed (P1/P2) — this is
    // a deliberate P0 tradeoff (safety over feature completeness), not
    // an oversight. Compliance/invoice documents are handled entirely
    // separately, under compliance_quarantine/ and compliance_docs/
    // below — never under this products/ path.
    match /products/{businessId}/{allPaths=**} {
      allow read: if isSignedIn()
        && (isBusinessOwner(businessId) || isAdmin());
      allow create, update: if isSignedIn()
        && isBusinessOwner(businessId)
        && hasAllowedProductImage();
      allow delete: if isSignedIn()
        && (isBusinessOwner(businessId) || isAdmin());
    }

    match /products_raw/{businessId}/{allPaths=**} {
      allow read: if isSignedIn()
        && (isBusinessOwner(businessId) || isAdmin());
      allow create, update: if isSignedIn()
        && isBusinessOwner(businessId)
        && hasAllowedProductImage();
      allow delete: if isSignedIn()
        && (isBusinessOwner(businessId) || isAdmin());
    }

    // Business gallery media, cross-sector repair. Both blocks below are
    // scoped to a single business namespace and authorized ONLY through
    // isBusinessOwner(), which resolves ownership from the canonical
    // businesses/{businessId}.ownerUid document. Ownership is never
    // inferred from request.auth.uid == businessId, and never from client
    // custom metadata: a business document that is missing, has no
    // ownerUid, has a null ownerUid, or has a non-string ownerUid makes
    // the firestore.get() comparison fail and the write is denied, so
    // every malformed ownership state fails closed. That also means an
    // upload attempted before registerBusiness has created the business
    // document is denied — registration-time staged uploads need a
    // server-issued session and finalization/cleanup architecture (see
    // compliance_quarantine/ below for the shape that takes) and are
    // deliberately NOT authorized here.
    //
    // The two matches are disjoint by segment count: {fileName} binds a
    // single segment, so business_gallery/{id}/videos/{name} can never be
    // written through the image block, and any deeper or differently
    // shaped path (business_gallery/{id}/a/b/c.jpg) matches neither block
    // and falls through to the deny-all at the bottom of this file.
    //
    // READ BOUNDARY — this is intentionally NOT a public-read rule. Read
    // is limited to the owning business and admins, exactly as products/
    // does, which is what the callers actually require: getDownloadURL()
    // is a Rules-evaluated metadata read performed by the owner right
    // after upload, and the dashboards' own management surfaces are
    // owner-only. Public visitors render these images from the tokenized
    // Firebase download URL persisted in Firestore, which bypasses Rules
    // entirely. Whether that tokenized-URL mechanism is the right
    // provenance model for public business media is a separate, still-open
    // architecture decision; this block neither settles it nor claims to.
    match /business_gallery/{businessId}/{fileName} {
      allow read: if isSignedIn()
        && (isBusinessOwner(businessId) || isAdmin());
      allow create, update: if isSignedIn()
        && isBusinessOwner(businessId)
        && hasAllowedBusinessImage();
      allow delete: if isSignedIn()
        && (isBusinessOwner(businessId) || isAdmin());
    }

    match /business_gallery/{businessId}/videos/{fileName} {
      allow read: if isSignedIn()
        && (isBusinessOwner(businessId) || isAdmin());
      allow create, update: if isSignedIn()
        && isBusinessOwner(businessId)
        && hasAllowedBusinessGalleryVideo();
      allow delete: if isSignedIn()
        && (isBusinessOwner(businessId) || isAdmin());
    }

    // Business cover image. Same owner-bound contract, same object
    // validator and the same read boundary as the gallery block above —
    // only the namespace differs, because the cover is a single replaceable
    // image rather than a gallery member. {fileName} binds exactly one
    // segment, so no nested object can be written here, and video is
    // rejected: hasAllowedBusinessImage() has no video content type.
    // Registration-time uploads remain denied for the same reason as the
    // gallery — isBusinessOwner() requires the canonical business document
    // to already exist.
    match /business_cover/{businessId}/{fileName} {
      allow read: if isSignedIn()
        && (isBusinessOwner(businessId) || isAdmin());
      allow create, update: if isSignedIn()
        && isBusinessOwner(businessId)
        && hasAllowedBusinessImage();
      allow delete: if isSignedIn()
        && (isBusinessOwner(businessId) || isAdmin());
    }

    // Marketplace P1-A compliance foundation (Slice 1) — docs/plans/
    // marketplace_p1a_compliance_review_implementation_plan_2026-08-21.md
    // §9/§16. The generic `{allPaths=**}` deny-all below already covers
    // these prefixes; both blocks are added explicitly anyway — not for
    // extra protection, but so Slice 2's diff (introducing the real,
    // session-gated `create` rule as one atomic security boundary with
    // its upload-session Cloud Functions) changes a single named,
    // already-tested block instead of inserting a brand-new one ahead of
    // an unrelated wildcard. No upload path is authorized here: no owner
    // upload, no admin upload, no signed-URL issuance, nothing.
    match /compliance_docs/{allPaths=**} {
      allow read, write: if false;
    }

    // Marketplace P1-A compliance foundation — Slice 2 security decision
    // (docs/plans/marketplace_p1a_compliance_review_implementation_plan_
    // 2026-08-21.md §9). The upload-session document (Firestore,
    // complianceUploadSessions/{sessionId}) is the sole source of truth
    // for whether a create is authorized — every condition below reads
    // it, never trusts a client-declared value. objectPath is compared
    // as an EXACT reconstructed-string match against the session's own
    // recorded objectPath field, not merely a per-segment pattern check,
    // so no combination of a real session with a substituted businessId/
    // sessionId/objectId can pass. Create-only: no update, no delete, no
    // read — matches the "Storage Rules authorize the upload; a trusted
    // server-side finalization/Storage event validates the resulting
    // object" boundary this plan explicitly does not ask Rules to close
    // alone (see functions/src/marketplace/compliance/
    // complianceUploadFinalization.js for that server-side half).
    function complianceUploadSessionData(sessionId) {
      return firestore.get(
        /databases/(default)/documents/complianceUploadSessions/$(sessionId)
      ).data;
    }

    // Marketplace Revision 30 §F (Slice 2) — the live generation of the
    // canonical business document. The session records the generation it
    // was issued under; requiring the two to be equal means an upload
    // authorized before a business was deleted and recreated under the same
    // id cannot be completed against the new generation. Both sides must be
    // present non-empty strings: an absent or malformed generation is never
    // read as "no generation, therefore fine", it denies.
    function liveBusinessGeneration(businessId) {
      return firestore.get(
        /databases/(default)/documents/businesses/$(businessId)
      ).data.marketplaceBusinessGenerationId;
    }

    match /compliance_quarantine/{businessId}/{sessionId}/{objectId} {
      // `resource == null` is checked explicitly, not inferred from the
      // create/update keyword split alone: a prior write attempt at this
      // exact path (even one Firebase's own create/update classification
      // might otherwise treat ambiguously) must never be treated as
      // authorized just because the session itself is still valid — the
      // session authorizes exactly one object write, never a
      // replacement of one that already exists.
      allow write: if resource == null
        && isSignedIn()
        && isBusinessOwner(businessId)
        && complianceUploadSessionData(sessionId).businessId == businessId
        && complianceUploadSessionData(sessionId).issuedBy == request.auth.uid
        && complianceUploadSessionData(sessionId).status == 'upload_authorized'
        && complianceUploadSessionData(sessionId).expiresAt > request.time
        && complianceUploadSessionData(sessionId).objectPath ==
           ('compliance_quarantine/' + businessId + '/' + sessionId + '/' + objectId)
        // Revision 30 §F generation binding — see liveBusinessGeneration().
        && complianceUploadSessionData(sessionId).marketplaceBusinessGenerationId is string
        && complianceUploadSessionData(sessionId).marketplaceBusinessGenerationId.size() > 0
        && liveBusinessGeneration(businessId) is string
        && complianceUploadSessionData(sessionId).marketplaceBusinessGenerationId ==
           liveBusinessGeneration(businessId)
        && request.resource.size > 0
        && request.resource.size <= complianceUploadSessionData(sessionId).maxSizeBytes
        && request.resource.contentType == complianceUploadSessionData(sessionId).declaredMimeType
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && objectId.matches(
          '.*\\.([pP][dD][fF]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[pP][nN][gG])$'
        )
        // Slice 2 correction (adversarial review 2026-08-21, finding E):
        // no client custom metadata at all — request.resource.metadata is
        // always a map (never absent), so requiring it empty denies both
        // an arbitrary client-set key AND a hand-set
        // firebaseStorageDownloadTokens value in the same check, with no
        // exception carved out. Nothing in this upload flow requires the
        // client to set any custom metadata; the eventual promoted
        // compliance_docs/ object gets its own closed, server-written
        // metadata map (see complianceScanOrchestration.js's
        // performPromotion), never inherited from this one.
        && request.resource.metadata.size() == 0;
      // `resource == null` above already makes an update-after-create
      // (including a metadata-only update, e.g. updateMetadata()) fall
      // through to this deny — resource is non-null once the object
      // exists, so the `allow write` condition's own first clause fails.
      allow read, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
