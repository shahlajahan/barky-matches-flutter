rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function hasAllowedMedia() {
      return request.resource != null
        && request.resource.size <= 104857600
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp|gif|heic)|video/(mp4|quicktime|webm)'
        )
        && request.resource.name.matches(
          '.*\\.(jpg|jpeg|png|webp|gif|heic|mp4|mov|webm)$'
        );
    }

    function hasAllowedDocument() {
      return request.resource != null
        && request.resource.size <= 26214400
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp|heic)|application/pdf'
        )
        && request.resource.name.matches(
          '.*\\.(jpg|jpeg|png|webp|heic|pdf)$'
        );
    }

    match /business_sector_docs/{ownerUid}/pet_taxi/{allPaths=**} {
      allow read: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin());
      allow create, update: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin())
        && hasAllowedDocument();
      allow delete: if isSignedIn()
        && (request.auth.uid == ownerUid || isAdmin());
    }

    match /business_sector_docs/{ownerUid}/{sector}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == ownerUid;
      allow create, update: if isSignedIn()
        && request.auth.uid == ownerUid
        && hasAllowedDocument();
      allow delete: if isSignedIn() && request.auth.uid == ownerUid;
    }

    match /stories/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && hasAllowedMedia();
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /social_posts/{userId}/{postId}/{allPaths=**} {
      allow read: if resource.metadata.visibility == 'public'
        || (request.auth != null && request.auth.uid == userId)
        || isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && hasAllowedMedia();
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
