rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return isRegisteredUser();
    }

    function isAnonymousUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRegisteredUser() {
      return request.auth != null && !isAnonymousUser();
    }

    function isAdmin() {
      return isSignedIn()
        && 'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function financeRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isFinanceViewer() {
      return financeRole() in [
        'admin',
        'super_admin',
        'finance_viewer',
        'finance_operator',
        'finance_manager'
      ];
    }

    function isBusinessOwner(businessId) {

  return isSignedIn()

    && businessId is string

    && (

      get(
        /databases/$(database)/documents/businesses/$(businessId)
      ).data.ownerUid == request.auth.uid

      ||

      get(
        /databases/$(database)/documents/businesses/$(businessId)
      ).data.contact.email == request.auth.token.email

    );
}

    function isSellerOrderBusinessOwner(data) {
      return isSignedIn() && (
        (data.businessId is string && isBusinessOwner(data.businessId)) ||
        (data.shopId is string && isBusinessOwner(data.shopId)) ||
        data.sellerUid == request.auth.uid ||
        data.ownerUid == request.auth.uid
      );
    }

    function isOwnUserDoc(userId) {
      return isSignedIn() && userId is string && request.auth.uid == userId;
    }

    function isBusinessDocumentOwner(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    // Defense-in-depth against a tampered/unsupported legal.companyType on a
    // direct client create of businesses/{businessId} or business_requests
    // (registerBusiness, the trusted Cloud Function, is the authoritative
    // enforcement point for the full document-requirement matrix — see
    // functions/business/businessDocumentRequirements.js — this only
    // rejects an invalid enum value, it does not compute required
    // documents). companyType is optional at this layer (absent is
    // legacy-compatible); only an explicitly-set invalid value is rejected.
    function isValidOrAbsentCompanyType(legalData) {
      return !('companyType' in legalData)
        || legalData.companyType == null
        || legalData.companyType in [
          'sole_proprietorship',
          'limited_company',
          'joint_stock_company'
        ];
    }

    function isCanonicalBusinessOwner(businessId) {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/businesses/$(businessId)
        ).data.ownerUid == request.auth.uid;
    }

    function canOwnerUpdateBusinessDocument(businessId) {
      return isCanonicalBusinessOwner(businessId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status',
          'published',
          'verification',
          'trust',
          'riskFlags',
          'ownerUid',
          'createdAt',
          // Marketplace P1-A Step 21c2 (docs/plans/marketplace_p1a_
          // compliance_review_implementation_plan_2026-08-21.md §10.1
          // "Marketplace seller-activation gate contract"): only the two
          // authorized admin-only server operations (Admin SDK, bypasses
          // Rules by construction) may ever write this key. A business
          // owner, or any other authenticated client, may never create,
          // replace, merge, update, delete, or otherwise transform it.
          'marketplaceSellerActivation',
          // Revision 28 (§10.1 "Pilot Product Approval contract" /
          // "Business-generation architecture"): both server-owned,
          // written only by the pilot-approval operations/
          // `grantMarketplaceSellerActivation`/`CREATE BUSINESS
          // (PENDING)` — never by an owner client write, by any means.
          'pilotActiveProductCount',
          'marketplaceBusinessGenerationId'
        ]);
    }

    // Marketplace seller-activation admin client-SDK hotfix (docs/plans/
    // marketplace_p1a_compliance_review_implementation_plan_2026-08-21.md
    // §10.1 "Rules responsibility boundary", closing reviews), extended by
    // Revision 28 to cover this contract's own two new server-owned
    // business fields (`pilotActiveProductCount`,
    // `marketplaceBusinessGenerationId`) identically: the create/update
    // rules below historically OR'd `isAdmin()` against a narrower,
    // owner-only branch that alone carried this protection — an
    // authenticated admin using the Firebase client SDK (never the Admin
    // SDK, which bypasses Rules by construction) could forge or overwrite
    // any of these three fields directly. The helpers below are AND-ed
    // onto the FULL create/update/delete rules, outside the `isAdmin()`/
    // owner authorization OR, so they apply identically to every Firebase
    // client-SDK actor, admin included. Only the designated admin-only
    // server operations (`grantMarketplaceSellerActivation`/
    // `revokeMarketplaceSellerActivation`, `approvePilotProduct`/
    // `revokePilotProductApproval`, the shared `deactivateAllPilotProducts`
    // helper's call sites, and the `CREATE BUSINESS (PENDING)` call site —
    // all Admin SDK, unaffected by any Rules change) may ever write any of
    // these three fields.
    function marketplacePilotServerOwnedBusinessFields() {
      return [
        'marketplaceSellerActivation',
        'pilotActiveProductCount',
        'marketplaceBusinessGenerationId'
      ];
    }

    function omitsMarketplaceSellerActivationOnCreate(data) {
      return !data.keys().hasAny(marketplacePilotServerOwnedBusinessFields());
    }

    function preservesMarketplaceSellerActivationOnUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(marketplacePilotServerOwnedBusinessFields());
    }

    // Canonical business media (logo / cover / gallery).
    //
    // `businessMedia` is written exclusively by the `finalizeBusinessMedia`
    // callable (Admin SDK, which bypasses Rules by construction — see
    // functions/src/business/businessMedia.js). Rules cannot reach Cloud
    // Storage, so they cannot prove that a referenced object exists, sits in
    // this business's own namespace, or carries a permitted content type and
    // size; a Rules-only contract could therefore never stop an owner from
    // writing an arbitrary external URL into a public media field. Making the
    // whole map server-owned moves that proof to the one actor that can
    // actually perform it.
    //
    // Like marketplacePilotServerOwnedBusinessFields() above, this is AND-ed
    // onto the FULL create/update rules — outside the isAdmin()/owner
    // authorization OR — so it binds every Firebase client-SDK actor
    // identically, admin included. The legacy display fields
    // (`profile.logoUrl`, `coverImageUrl`, `images`, `clinicPhotoUrls`, ...)
    // are deliberately NOT listed: other sectors still write them through
    // their own dashboards, and narrowing them here would break those
    // surfaces. They remain a read-only public fallback only.
    function serverOwnedBusinessMediaFields() {
      return ['businessMedia'];
    }

    function omitsBusinessMediaOnCreate(data) {
      return !data.keys().hasAny(serverOwnedBusinessMediaFields());
    }

    function preservesBusinessMediaOnUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(serverOwnedBusinessMediaFields());
    }

    // Delete safety, exact: `resource.data` is the business document
    // about to be deleted (Rules evaluate `delete` against the
    // pre-existing document; no separate `get()` needed). Exactly
    // three shapes: the key is absent (deletable); a well-formed map
    // with `active` a literal bool equal to `false` (deletable — a
    // valid, currently-inactive activation); or anything else present
    // that is not that exact well-formed-inactive shape — including a
    // valid `active: true` map, or any malformed/mistyped value — which
    // fails closed and denies deletion. A currently-active business
    // must be revoked first, through the designated backend operation,
    // before its document may be deleted by any Firebase client SDK
    // actor, owner or admin alike.
    function businessHasNoActiveMarketplaceSellerActivation() {
      return !('marketplaceSellerActivation' in resource.data)
        || (
          resource.data.marketplaceSellerActivation is map
          && resource.data.marketplaceSellerActivation.active is bool
          && resource.data.marketplaceSellerActivation.active == false
        );
    }

    // Revision 28 (§10.1 "New, narrowest-possible Rules-level
    // immediate-safety precondition on direct client business
    // deletion"), extending the delete-safety pattern above to the
    // pilot-product counter: absent is treated as `0` (Option A — no
    // pilot approval can exist without this counter having first been
    // incremented by `approvePilotProduct`'s own transaction, so an
    // absent counter is structurally proven to mean zero, not merely
    // assumed); an exact, typed `== 0` integer match is deletable;
    // anything else (a positive integer, or a malformed/mistyped value)
    // fails closed and denies deletion.
    function businessHasNoActivePilotProducts() {
      return !('pilotActiveProductCount' in resource.data)
        || (
          resource.data.pilotActiveProductCount is int
          && resource.data.pilotActiveProductCount == 0
        );
    }

    // Marketplace P1-A Step 21c2 (§10.1 "Fail-closed Rules predicate,
    // exact"): the one and only mechanism behind every fail-closed
    // outcome this gate requires. Every clause below independently
    // denies a distinct malformed/missing shape — a missing business
    // document, a missing/malformed activation object, or a missing/
    // null/non-boolean/false `active` value.
    function hasActiveMarketplaceSellerActivation(businessId) {
      return businessId is string
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId))
             .data.marketplaceSellerActivation is map
        && get(/databases/$(database)/documents/businesses/$(businessId))
             .data.marketplaceSellerActivation.active is bool
        && get(/databases/$(database)/documents/businesses/$(businessId))
             .data.marketplaceSellerActivation.active == true;
    }

    function isPublicBusiness(businessId) {
      return get(
        /databases/$(database)/documents/businesses_public/$(businessId)
      ).data.status == 'approved'
        && get(
          /databases/$(database)/documents/businesses_public/$(businessId)
        ).data.published == true
        && get(
          /databases/$(database)/documents/businesses/$(businessId)
        ).data.status == 'approved'
        && get(
          /databases/$(database)/documents/businesses/$(businessId)
        ).data.published == true;
    }

    function isChatParticipant(data) {
      return isRegisteredUser()
        && 'participants' in data
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function isValidDirectChatCreate(chatId) {
      return isRegisteredUser()
        && request.resource.data.keys().hasOnly([
          'chatId',
          'type',
          'participants',
          'participantMap',
          'participantNames',
          'participantPhotos',
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'unreadCount',
          'createdBy',
          'createdAt',
          'updatedAt',
          'schemaVersion'
        ])
        && (
          chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
          || !('lastSenderId' in request.resource.data)
        )
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && (
          !('chatId' in request.resource.data)
          || request.resource.data.chatId == chatId
        )
        && (
          !('type' in request.resource.data)
          || request.resource.data.type == 'direct'
        )
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && (
          !('createdBy' in request.resource.data)
          || request.resource.data.createdBy == request.auth.uid
        )
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1]))
        && request.resource.data.lastMessage == ''
        && (
          !('lastSenderId' in request.resource.data)
          || request.resource.data.lastSenderId == ''
        );
    }

    function isMissingCanonicalDirectChatLookup(chatId) {
      return isRegisteredUser()
        && !exists(/databases/$(database)/documents/chats/$(chatId))
        && (
          chatId.matches(request.auth.uid + '_.*')
          || chatId.matches('.*_' + request.auth.uid)
        );
    }

    function chatParticipantsUnchanged() {
      return request.resource.data.participants == resource.data.participants
        && (
          !('participantMap' in resource.data)
          || request.resource.data.participantMap == resource.data.participantMap
        )
        && (
          !('createdBy' in resource.data)
          || request.resource.data.createdBy == resource.data.createdBy
        )
        && (
          !('chatId' in resource.data)
          || request.resource.data.chatId == resource.data.chatId
        )
        && (
          !('type' in resource.data)
          || request.resource.data.type == resource.data.type
        )
        && (
          !('schemaVersion' in resource.data)
          || request.resource.data.schemaVersion == resource.data.schemaVersion
        );
    }

    function isValidChatParticipantUpdate() {
      return isChatParticipant(resource.data)
        && chatParticipantsUnchanged()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'participantNames',
            'participantPhotos',
            'lastMessage',
            'lastMessageAt',
            'lastSenderId',
            'unreadCount',
            'updatedAt'
          ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSenderId'])
          || request.resource.data.lastSenderId == request.auth.uid
          || request.resource.data.lastSenderId == ''
        );
    }

    function isValidChatMessageCreate(chatId) {
      return isRegisteredUser()
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.participants
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'messageId',
          'chatId',
          'senderId',
          'receiverId',
          'senderName',
          'text',
          'type',
          'createdAt',
          'seenBy'
        ])
        && (
          !('chatId' in request.resource.data)
          || request.resource.data.chatId == chatId
        )
        && (
          !('receiverId' in request.resource.data)
          || (
            request.resource.data.receiverId in get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants
            && request.resource.data.receiverId != request.auth.uid
          )
        );
    }

    function isBusinessChatParticipant(data) {
      return isRegisteredUser() && (
        ('participants' in data && data.participants is list
          && request.auth.uid in data.participants) ||
        ('clientUserId' in data && data.clientUserId == request.auth.uid) ||
        ('businessId' in data && data.businessId is string
          && isCanonicalBusinessOwner(data.businessId))
      );
    }

    function isVetChatParticipant(data) {
      return isRegisteredUser() && (
        ('participants' in data && data.participants is list
          && request.auth.uid in data.participants) ||
        ('clientUserId' in data && data.clientUserId == request.auth.uid) ||
        ('vetUserId' in data && data.vetUserId == request.auth.uid) ||
        ('businessId' in data && data.businessId is string
          && isCanonicalBusinessOwner(data.businessId))
      );
    }

    function isAppointmentOwner(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.buyerUid == request.auth.uid
      );
    }

    function canOwnerCancel(oldData, newData) {
      return oldData.status in ['pending', 'awaiting_payment', 'confirmed', 'confirmed_paid']
        && newData.status == 'cancelled_by_user';
    }

    function canStaffUpdate(oldData, newData) {
      return (
        (oldData.status == 'pending' && newData.status in ['awaiting_payment', 'confirmed', 'rejected']) ||
        (oldData.status == 'awaiting_payment' && newData.status in ['confirmed_paid', 'payment_expired']) ||
        (oldData.status == 'confirmed' && newData.status in ['completed', 'cancelled_by_vet', 'rejected']) ||
        (oldData.status == 'confirmed_paid' && newData.status == 'completed')
      );
    }

    function canGroomyStaffUpdate(oldData, newData) {
      return (
        (oldData.status == 'pending' && newData.status in ['awaiting_payment', 'confirmed', 'rejected']) ||
        (oldData.status == 'awaiting_payment' && newData.status in ['confirmed_paid', 'payment_expired', 'cancelled_by_groomy']) ||
        (oldData.status == 'confirmed' && newData.status in ['completed', 'cancelled_by_groomy', 'rejected']) ||
        (oldData.status == 'confirmed_paid' && newData.status in ['completed', 'cancelled_by_groomy'])
      );
    }

    function canHotelStaffUpdate(oldData, newData) {
      return (
        (oldData.status == 'pending' && newData.status in ['awaiting_payment', 'confirmed', 'rejected', 'cancelled_by_hotel']) ||
        (oldData.status == 'awaiting_payment' && newData.status in ['confirmed_paid', 'payment_expired', 'cancelled_by_hotel']) ||
        (oldData.status == 'confirmed' && newData.status in ['checked_in', 'completed', 'cancelled_by_hotel', 'rejected']) ||
        (oldData.status == 'confirmed_paid' && newData.status in ['checked_in', 'completed', 'cancelled_by_hotel']) ||
        (oldData.status == 'checked_in' && newData.status in ['completed', 'cancelled_by_hotel'])
      );
    }

    function canPetTaxiStaffUpdate(oldData, newData) {
      return (
        (oldData.status == 'pending' && newData.status == 'cancelled_by_business') ||
        (oldData.status == 'awaiting_user_payment' && newData.status == 'cancelled_by_business') ||
        (oldData.status == 'payment_failed' && newData.status == 'cancelled_by_business') ||
        (oldData.status == 'confirmed_paid' && newData.status in ['driver_on_the_way', 'cancelled_by_business']) ||
        (oldData.status == 'driver_on_the_way' && newData.status in ['arrived', 'cancelled_by_business']) ||
        (oldData.status == 'arrived' && newData.status in ['pet_picked_up', 'cancelled_by_business']) ||
        (oldData.status == 'pet_picked_up' && newData.status in ['on_trip', 'cancelled_by_business']) ||
        (oldData.status == 'on_trip' && newData.status in ['completed', 'cancelled_by_business'])
      );
    }

    function canPetTaxiStaffProposePrice(oldData, newData) {
      return oldData.status in ['pending', 'awaiting_user_payment', 'payment_failed']
        && newData.status == 'awaiting_user_payment'
        && newData.finalPrice is number
        && newData.finalPrice > 0
        && newData.finalPriceCurrency is string
        && newData.priceConfirmedBy == request.auth.uid;
    }

    function canPetTaxiUserCancel(oldData, newData) {
      return oldData.status in ['pending', 'awaiting_user_payment', 'payment_failed', 'driver_on_the_way']
        && newData.status == 'cancelled_by_user';
    }

    function isStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']);
    }

    function isPetTaxiStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'status',
        'updatedAt',
        'lastStatusChange',
        'finalPrice',
        'finalPriceCurrency',
        'priceConfirmedBy',
        'priceConfirmedAt',
        'userAcceptedPrice',
        'userAcceptedAt',
        'userRejectedPrice',
        'userRejectedAt',
        'paymentStatus',
        'paymentAmount',
        'paymentCurrency',
        'providerPayoutStatus',
        'providerPayoutAt'
      ]);
    }

    function isNotificationOwner(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.recipientUserId == request.auth.uid ||
        data.targetUserId == request.auth.uid ||
        data.fromUserId == request.auth.uid
      );
    }

    function isSubscriptionOwner(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.buyerUid == request.auth.uid
      );
    }

    function isOrderOwner(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.buyerUid == request.auth.uid
      );
    }

    function isPlayDateRequestParticipant(data) {
      return isSignedIn() && (
        data.requesterUserId == request.auth.uid ||
        data.requesterId == request.auth.uid ||
        data.requestedUserId == request.auth.uid ||
        data.targetUserId == request.auth.uid ||
        data.ownerId == request.auth.uid ||
        data.targetOwnerId == request.auth.uid
      );
    }

   function isAdoptionRequestParticipant(data) {

  return isSignedIn() && (

    data.requesterUserId == request.auth.uid ||

    data.requesterId == request.auth.uid ||

    data.ownerId == request.auth.uid ||

    data.targetUserId == request.auth.uid ||

    data.targetOwnerId == request.auth.uid ||

    (
      data.targetOwnerId is string &&
      isBusinessOwner(
        data.targetOwnerId
      )
    )

  );

}

match /adoption_pets/{petId} {

  allow read: if isSignedIn();

  allow create:
    if isSignedIn()
    && request.resource.data.businessId is string
    && isBusinessOwner(
      request.resource.data.businessId
    );

  allow update, delete:
    if isAdmin()
    || (
      isSignedIn()
      && resource.data.businessId is string
      && isBusinessOwner(
        resource.data.businessId
      )
    );
}

allow read: if isAdmin() || (

  isSignedIn() && (

    resource.data.requesterUserId
      == request.auth.uid ||

    (

      resource.data.businessId
          is string &&

      isBusinessOwner(
        resource.data.businessId
      )

    ) ||

    (

      resource.data.targetOwnerId
          is string &&

      isBusinessOwner(
        resource.data.targetOwnerId
      )

    )

  )

);

    function isBusinessRequestOwner(data) {
      return isSignedIn() && (
        data.uid == request.auth.uid ||
        data.ownerUid == request.auth.uid ||
        data.requesterId == request.auth.uid
      );
    }

    function isFeedbackOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isComplaintOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isLikeOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isReviewOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isReviewLikeOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['likes', 'likedBy']);
    }

    function isSocialPostEligibleForInteraction(data) {
      return data.visibility == 'public'
        && (!('published' in data) || data.published == true)
        && (!('moderationStatus' in data) || data.moderationStatus == 'active')
        && (!('isHidden' in data) || data.isHidden == false);
    }

    function priorSocialPostLikeCount() {
      return resource.data.likeCount is int ? resource.data.likeCount : 0;
    }

    // ── Atomic like/counter coupling ──────────────────────────────────
    // A bare "changed keys == likeCount, delta == +/-1" rule bounds the
    // SIZE of a write but proves nothing about whether it corresponds to
    // a real like/unlike: a malicious client could call
    // postRef.update({likeCount: increment(1)}) standalone, repeatedly,
    // with no post_likes document ever created. These helpers close that
    // gap by requiring the counter transition and the caller's own
    // deterministic post_likes/{postId}_{uid} existence transition to
    // happen in the SAME write/commit, verified from both sides:
    //   - the social_posts update rule checks the like doc's before/after
    //     existence via exists()/existsAfter();
    //   - the post_likes create/delete rule checks the counter's
    //     before/after value via get()/getAfter().
    // Both must independently agree for the batch to commit, so neither a
    // standalone counter write nor a standalone membership write (without
    // its paired counter change) can succeed.
    function likeMembershipExistsBefore(postId, uid) {
      return exists(/databases/$(database)/documents/post_likes/$(postId + '_' + uid));
    }

    function likeMembershipExistsAfter(postId, uid) {
      return existsAfter(/databases/$(database)/documents/post_likes/$(postId + '_' + uid));
    }

    function socialPostLikeCountBefore(postId) {
      let post = get(/databases/$(database)/documents/social_posts/$(postId)).data;
      return 'likeCount' in post && post.likeCount is int ? post.likeCount : 0;
    }

    function socialPostLikeCountAfter(postId) {
      let post = getAfter(/databases/$(database)/documents/social_posts/$(postId)).data;
      return 'likeCount' in post && post.likeCount is int ? post.likeCount : 0;
    }

    // Lets any eligible signed-in user bump a public post's own likeCount
    // by exactly +1/-1 through SocialPostService.toggleLike's batch,
    // requiring the same commit to create/delete their own deterministic
    // post_likes/{postId}_{uid} document — see the block comment above.
    function isSocialPostLikeCounterOnlyUpdate(postId) {
      return isSocialPostEligibleForInteraction(resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (
          (
            request.resource.data.likeCount == priorSocialPostLikeCount() + 1
            && !likeMembershipExistsBefore(postId, request.auth.uid)
            && likeMembershipExistsAfter(postId, request.auth.uid)
          ) ||
          (
            request.resource.data.likeCount == priorSocialPostLikeCount() - 1
            && likeMembershipExistsBefore(postId, request.auth.uid)
            && !likeMembershipExistsAfter(postId, request.auth.uid)
          )
        );
    }

    // The mirror-image check, evaluated from the post_likes side: a
    // create is only valid if the paired parent counter went up by
    // exactly 1 in the same commit; a delete only if it went down by 1.
    function isAtomicLikeCreatePair(postId) {
      return socialPostLikeCountAfter(postId) == socialPostLikeCountBefore(postId) + 1;
    }

    function isAtomicLikeDeletePair(postId) {
      return socialPostLikeCountAfter(postId) == socialPostLikeCountBefore(postId) - 1;
    }

    function isEligibleSocialPostId(postId) {
      return postId is string
        && postId.size() > 0
        && exists(/databases/$(database)/documents/social_posts/$(postId))
        && isSocialPostEligibleForInteraction(
          get(/databases/$(database)/documents/social_posts/$(postId)).data
        );
    }

    function ownerProfileEditableFields() {
      return [
        'ownerName',
        'ownerPhone',
        'emergencyContact',
        'emergencyPhone',
        'city',
        'district',
        'address'
      ];
    }

    function changedOwnerProfileKeysAreAllowed() {
      return !('ownerProfile' in request.resource.data)
        || !('ownerProfile' in resource.data)
        || !(resource.data.ownerProfile is map)
        || request.resource.data.ownerProfile
          .diff(resource.data.ownerProfile)
          .affectedKeys()
          .hasOnly(ownerProfileEditableFields());
    }

    function createdOwnerProfileKeysAreAllowed() {
      return !('ownerProfile' in request.resource.data)
        || (
          'ownerProfile' in resource.data
          && resource.data.ownerProfile is map
        )
        || (
          request.resource.data.ownerProfile is map
          && request.resource.data.ownerProfile.keys().hasOnly(ownerProfileEditableFields())
        );
    }

    function isOwnerProfileSnapshotUpdate() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'ownerProfile',
          'ownerProfileUpdatedAt',
          'updatedAt'
        ])
        && (
          !('ownerProfile' in request.resource.data)
          || request.resource.data.ownerProfile is map
        )
        && changedOwnerProfileKeysAreAllowed()
        && createdOwnerProfileKeysAreAllowed();
    }

    function protectedUserFields() {
      return [
        'uid',
        'userId',
        'ownerUid',
        'ownerId',
        'role',
        'admin',
        'isAdmin',
        'isPremium',
        'subscription',
        'subscriptions',
        'subscriptionPlan',
        'subscriptionStatus',
        'entitlement',
        'entitlements',
        'businessId',
        'businessOwnerUid',
        'creator'
      ];
    }

    function protectedUserCreateFields() {
      // 'isPremium' is intentionally excluded from this list. It is handled
      // separately by isLegacyIsPremiumFalseCreate() below: a narrow,
      // exact-`false`-only backward-compatibility exception for already-
      // released app versions whose signup payload still includes
      // `isPremium: false`. It is never permitted to be `true` on create,
      // and remains fully protected from any update — see
      // protectedUserFields()/selfUserUpdateFieldsAreAllowed below, which is
      // unchanged and still includes 'isPremium'.
      return [
        'userId',
        'ownerUid',
        'ownerId',
        'role',
        'admin',
        'isAdmin',
        'subscription',
        'subscriptions',
        'subscriptionPlan',
        'subscriptionStatus',
        'entitlement',
        'entitlements',
        'businessId',
        'businessOwnerUid',
        'creator'
      ];
    }

    // Backward compatibility for already-released clients: pre-fix versions
    // of buildSocialProfileCreationData() (lib/services/social_auth_service.dart)
    // send `isPremium: false` on initial profile creation, which used to be
    // unconditionally rejected by protectedUserCreateFields() — causing Auth
    // sign-in to succeed while the users/{uid} profile silently failed to be
    // created. Only an exact literal `false` is ever accepted here;
    // `isPremium: true` (or any other value) is always rejected. This
    // exception applies to document creation only — isPremium remains fully
    // update-protected via protectedUserFields()/selfUserUpdateFieldsAreAllowed.
    // Safe to remove once no released client version still sends isPremium on
    // signup (the fixed client omits it entirely, which this also permits).
    function isLegacyIsPremiumFalseCreate() {
      return !('isPremium' in request.resource.data)
        || request.resource.data.isPremium == false;
    }

    function selfUserCreateFieldsAreAllowed(userId) {
      return !request.resource.data.keys().hasAny(protectedUserCreateFields())
      && isLegacyIsPremiumFalseCreate()
      && (
        !('uid' in request.resource.data)
        || request.resource.data.uid == userId
      );
    }

    function selfUserUpdateFieldsAreAllowed() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(protectedUserFields());
    }

    function isOfferClickCountOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['clickCount']);
    }

    match /users/{userId} {
      allow read: if isOwnUserDoc(userId) || isAdmin();

      // SEC-1 fix (docs/architecture/creator-referral-engine.md, Finding
      // SEC-1 / Design Invariants): the `creator` map is server-authoritative
      // — only Cloud Functions (Admin SDK, which bypasses these rules) may
      // create, activate, deactivate, or otherwise write it. Neither the
      // document owner nor an admin acting through the client SDK may touch
      // it; admin creator actions must go through the dedicated callables
      // (createCreatorProfile / assignReferralCode / activateCreator /
      // deactivateCreator). Every other field on this document keeps its
      // existing self-or-admin write access, unchanged.
      allow create: if (
          (isOwnUserDoc(userId) && selfUserCreateFieldsAreAllowed(userId))
          || isAdmin()
        )
        && !('creator' in request.resource.data);
      allow update: if (
          (isOwnUserDoc(userId) && selfUserUpdateFieldsAreAllowed())
          || isAdmin()
        )
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creator']);
      allow delete: if isOwnUserDoc(userId) || isAdmin();

      // This nested wildcard is not purely a subcollection rule: when
      // {document=**} matches zero path segments it also matches the
      // parent users/{userId} document itself (Firestore rules OR-combine
      // every matching allow statement), so it must carry the exact same
      // SEC-1 restriction as the explicit rules above or it silently
      // re-opens the hole they close. Confirmed empirically with the
      // Firestore emulator: the initial version of this fix (restriction
      // above, unrestricted grant here) still let a self-write set
      // creator.enabled — this block was the reason why.
      match /{document=**} {
        allow read: if isOwnUserDoc(userId) || isAdmin();
        allow create: if (
            (isOwnUserDoc(userId) && selfUserCreateFieldsAreAllowed(userId))
            || isAdmin()
          )
          && !('creator' in request.resource.data);
        allow update: if (
            (isOwnUserDoc(userId) && selfUserUpdateFieldsAreAllowed())
            || isAdmin()
          )
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creator']);
        allow delete: if isOwnUserDoc(userId) || isAdmin();
      }
    }

    match /users_public/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Creator Referral Engine — Sprint 3 attribution and qualification
    // foundation (see
    // docs/architecture/creator-referral-engine.md and
    // docs/SPRINT1_REPORT.md). Only this one collection is needed this
    // sprint; referralClicks / referralCampaigns / referralDailyStats remain
    // deferred to later sprints. Attribution and qualification writes are
    // Functions-only, including the pending -> qualified transition.
    match /referralCodes/{code} {
      // Public read: a future click-tracking/landing page must be able to
      // resolve a code's validity before the visitor has any account.
      allow read: if true;
      // Functions-only write (Admin SDK bypasses these rules) — assigned
      // exclusively by the assignReferralCode callable.
      allow write: if false;
    }

    match /referralAttributions/{referredUid} {
      // Referred users, the referring creator, and admins may inspect the
      // immutable record. Creation and all subsequent writes are Functions-only.
      allow read: if isSignedIn() && (
        request.auth.uid == referredUid
        || resource.data.creatorUid == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }

    match /creator_reward_ledger/{ledgerId} {
      // Creators may inspect their own immutable ledger. Only backend
      // qualification transactions may create or change ledger records.
      allow read: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }

    match /dogs/{dogId} {

      function isDogOwner(data) {
        return isSignedIn() && (
          ('ownerId' in data && data.ownerId == request.auth.uid) ||
          ('ownerUid' in data && data.ownerUid == request.auth.uid)
        );
      }

      allow read:
        if isRegisteredUser()
        || (
          isAnonymousUser()
          && resource.data.isAvailableForAdoption == true
        );

      allow create:
        if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;

      allow update:
        if isAdmin() ||

        (
          isDogOwner(resource.data) &&

          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'petName',
              'age',
              'healthStatus',
              'isNeutered',
              'description',
              'traits',
              'ownerGender',
              'imagePaths',
              'isAvailableForAdoption',
            ])
        ) ||

        (
          isDogOwner(resource.data) &&
          isOwnerProfileSnapshotUpdate()
        );

      allow delete:
        if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.ownerId == request.auth.uid
        );
    }

match /dogs/{dogId}/vaccines/{vaccineId} {

  allow read:
    if isSignedIn();

  allow create:
    if isAdmin() ||
    (
      isSignedIn() &&
      request.resource.data.businessId is string &&
      isBusinessOwner(
        request.resource.data.businessId
      )
    );

  allow update, delete:
    if isAdmin() ||
    (
    isSignedIn() &&
      resource.data.businessId is string &&
      isBusinessOwner(
        resource.data.businessId
      )
    );
}

match /dogs/{dogId}/visits/{visitId} {

  allow read: if isAdmin() || (
    isSignedIn() &&
    (
      get(
        /databases/$(database)/documents/dogs/$(dogId)
      ).data.ownerId == request.auth.uid ||

      resource.data.ownerId == request.auth.uid ||

      (
        resource.data.businessId is string &&
        isBusinessOwner(
          resource.data.businessId
        )
      )
    )
  );

  allow create: if isAdmin() || (
    isSignedIn() &&
    request.resource.data.businessId is string &&
    isBusinessOwner(
      request.resource.data.businessId
    )
  );

  allow update, delete: if isAdmin() || (
    isSignedIn() &&
    resource.data.businessId is string &&
    isBusinessOwner(
      resource.data.businessId
    )
  );
}
    match /lost_pets/{dogId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /found_pets/{dogId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
   }
    match /businesses/{businessId} {
      allow read: if isBusinessDocumentOwner(resource.data) || isAdmin();
      allow create: if (
        isAdmin() || (
          isSignedIn() &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.published == false &&
          !request.resource.data.keys().hasAny([
            'verification',
            'trust',
            'riskFlags',
            'createdAt'
            // `marketplaceSellerActivation` removed from this
            // owner-only exclusion list — it is now enforced
            // unconditionally, for every actor including `isAdmin()`,
            // by `omitsMarketplaceSellerActivationOnCreate()` below.
          ]) &&
          (
            !('legal' in request.resource.data)
            || isValidOrAbsentCompanyType(request.resource.data.legal)
          )
        )
      ) && omitsMarketplaceSellerActivationOnCreate(request.resource.data)
        && omitsBusinessMediaOnCreate(request.resource.data);
      allow update: if (
        isAdmin() || canOwnerUpdateBusinessDocument(businessId)
      ) && preservesMarketplaceSellerActivationOnUpdate()
        && preservesBusinessMediaOnUpdate();
      allow delete: if (
        isAdmin() || isCanonicalBusinessOwner(businessId)
      ) && businessHasNoActiveMarketplaceSellerActivation()
        && businessHasNoActivePilotProducts();

      // Marketplace product compliance audit, P0 remediation (docs/audits/
      // marketplace_add_product_compliance_audit_2026-08-20.md): this
      // generic subcollection catch-all previously applied to `products`
      // too, since `{subcollection}` is an unconstrained wildcard — its
      // unconditional isCanonicalBusinessOwner() grant completely
      // bypassed the dedicated, hardened validation in the
      // `{path=**}/products/{productId}` match below (Firestore OR-combines
      // every matching rule, so the more permissive one always won).
      // `products` is carved out here and is governed exclusively by that
      // dedicated block. Every other existing subcollection (patients,
      // services, etc.) keeps its prior behavior unchanged.
      match /{subcollection}/{document=**} {
        allow read: if subcollection != 'products' &&
          (isCanonicalBusinessOwner(businessId) || isAdmin());
        allow create, update, delete:
          if subcollection != 'products' &&
          (isAdmin() || isCanonicalBusinessOwner(businessId));
      }
    }

    match /businesses_public/{businessId} {
      allow read: if true;
      allow write: if false;
    }

    match /businesses/{businessId}/services/{serviceId} {
      allow read: if isPublicBusiness(businessId);
      allow create, update, delete:
        if isAdmin() || isCanonicalBusinessOwner(businessId);
    }

    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && isOfferClickCountOnlyUpdate());
    }

    match /featured_deals/{dealId} {

  allow read: if isRegisteredUser() || isAnonymousUser();

  allow write: if isAdmin();

}

    match /{path=**}/products/{productId} {

  // Marketplace product compliance audit, P0 remediation
  // (docs/audits/marketplace_add_product_compliance_audit_2026-08-20.md,
  // findings F-02/F-03/F-07). Products are never self-approved or
  // self-published by a seller: every non-admin write is forced into
  // isActive == false / moderationStatus == 'pending_review', a fixed
  // known-safe category allowlist (fail-closed — no veterinary-medicine
  // option, no free-text bypass), an integer stock >= 1, and a lock on
  // every moderation/reservation field a seller must never touch. Public
  // reads only ever see approved + active products; a seller may still
  // read (but not publicly expose) their own pending/rejected products.

  // P0.1 correction (docs/audits/marketplace_p1_bulk_compliance_inventory_
  // architecture_2026-08-21.md, Revision 3 §6): request.resource.data is
  // ALWAYS the complete post-write document, not a diff — this is true on
  // update regardless of whether the client used set(), update(), or
  // set(merge:true). The original productProtectedKeysUntouched() checked
  // !data.keys().hasAny([blacklist]) against that complete document on
  // BOTH create and update. On create this is correct (a fresh submission
  // legitimately must not contain these keys at all). On update it is
  // wrong: the instant any Admin-SDK writer (functions/src/inventory/*)
  // sets one of these fields, EVERY subsequent seller edit's resulting
  // document still legitimately carries it forward unchanged — and the
  // bare presence check would reject that edit outright, permanently
  // locking the seller out of their own product, even though they never
  // touched the field. Harmless today only because the inventory module
  // is disabled in production (no real document has ever had these
  // fields set); would fire on the first canary activation.
  //
  // Fix: a server-owned field must be part of the closed document schema
  // (productAllowedFields()) so its mere presence never fails hasOnly(),
  // while its VALUE remains immutable to any seller write via a diff-based
  // unchanged-value check (sellerUpdateLeavesServerOwnedFieldsUntouched),
  // not a blacklist-style absence check. Create keeps a presence check
  // (sellerCreateHasNoServerOwnedFields) because there is no resource.data
  // to diff against yet — a fresh submission must omit these entirely.
  function serverOwnedProductFields() {
    return [
      // Already written today by functions/src/inventory/* (mirrors
      // SERVER_OWNED_INVENTORY_FIELDS in inventoryConstants.js) — inert
      // in production only because the M3/M5 feature flags are unset.
      'reservedStock',
      'inventorySchemaVersion',
      'inventoryOperationVersion',
      'inventoryUpdatedAt',
      // Reserved for a future admin-review write path; no code writes
      // these yet. Protected the same way now so activating that path
      // later cannot reintroduce this exact defect.
      'reviewedBy',
      'reviewedAt',
      'rejectionReason',
      'complianceStatus',
      // Revision 28 (§10.1 "Rules responsibility boundary"): a client
      // can never create, alter, activate, approve, revoke, or delete
      // this field by any write Rules permit — including a client-
      // submitted "self-revoking" shape (closing correction, plan
      // §10.1). Only `approvePilotProduct`/`revokePilotProductApproval`/
      // `unpublishPilotProductForRevision` and the shared
      // `deactivateAllPilotProducts` helper's call sites (Admin SDK,
      // unaffected by Rules) may ever write it.
      'pilotProductApproval'
    ].concat(complianceServerOwnedProductFields());
  }

  // Marketplace P1-A Slice 4.2 (docs/plans/marketplace_p1a_compliance_
  // review_implementation_plan_2026-08-21.md §9/§11, Revision 5 correction
  // 30-33): the exact, committed five-field server-owned compliance
  // output set — dormant today (no code writes these yet, §9's "Rollout
  // consequence" note), protected now via the identical create-absence/
  // update-immutability mechanism already proven above for the inventory/
  // moderation fields, so the real writer (Slice 4.3+) activating later
  // cannot reintroduce the exact defect this file's own P0.1 history
  // already fixed once. Distinct from productInputRevision, which is
  // seller-writable (see isValidTransitionalProductInputRevisionCreate/
  // Update below) and therefore deliberately NOT included in this list.
  function complianceServerOwnedProductFields() {
    return [
      'complianceEffectiveStatus',
      'complianceValidUntil',
      'evidenceRevision',
      'complianceUpdatedAt',
      'complianceReasonCode'
    ];
  }

  function sellerCreateHasNoServerOwnedFields(data) {
    return !data.keys().hasAny(serverOwnedProductFields());
  }

  function sellerUpdateLeavesServerOwnedFieldsUntouched(incoming, existing) {
    return !incoming.diff(existing).affectedKeys().hasAny(serverOwnedProductFields());
  }

  // P0 gap review: the exact, closed set of fields Product.toJson()
  // (lib/models/product.dart) ever writes, plus every server-owned field
  // above — every legitimate client write must be a subset of this list,
  // nothing more. This is the authoritative defense: an unknown field
  // (approved, published, publicationStatus, moderation, adminApproved,
  // inventoryOverride, customStatus, sellerUid, documentUrls, or anything
  // else not in this list) cannot be injected by any client write, admin
  // excepted. The seller-facing portion is kept in sync with toJson() by
  // construction — generated directly from it, not hand-guessed.
  function productAllowedFields() {
    return [
      'allowFreeShipping', 'allowPickup', 'allowReturns', 'allowSameDay',
      'allowedCarrierCodes', 'barcode', 'brand', 'businessId', 'businessLogo',
      'businessName', 'category', 'createdAt', 'currency', 'deliveryType',
      'description', 'excludedCities', 'fixedDesi', 'freeShippingThreshold',
      'hasContractedReturnCarrier', 'hasSmartPricing', 'heightCm', 'isActive',
      'isFragile', 'isOversize', 'isPerishable', 'isShippable', 'kdvRate',
      'lengthCm', 'marginPercent', 'markupPercent', 'maxDeliveryDays', 'media',
      // Revision 28 (§10.1 "Product binding, exact"): seller-submitted
      // once, at create, then immutable exactly like `sku` (below) — not
      // a `serverOwnedProductFields()` entry, since the client legitimately
      // submits it on create; its value is verified server-side (Rules
      // `get()`) against the owning business's own current value, below.
      'marketplaceBusinessGenerationId',
      'minStock', 'moderationStatus', 'name', 'originCity', 'preparationDays',
      'price', 'pricePosition', 'productId', 'productInputRevision',
      'returnCarrierCode',
      'returnShippingPayer', 'returnWindowDays', 'salePrice',
      'sellerRelationship', 'shippingFee',
      'shippingMode', 'shippingPayer', 'shippingProfile', 'shippingSnapshot',
      'sku', 'stock', 'suggestedMaxPrice', 'suggestedMinPrice', 'suggestedPrice',
      'taxIncluded', 'updatedAt', 'weightKg', 'wholesalePrice', 'widthCm',
      // Revision 31 §C / Revision 34: the authoritative pilot classification,
      // and Revision 35 (§0.33) its server-written provenance metadata.
      // Present here ONLY so their existence never fails this closed-schema
      // `hasOnly()` check once `setPilotProductClassification` has written
      // them — a seller may never add, change or remove any of the four
      // (preservesPilotProductClassOnUpdate, below), and no client may
      // create a product at all.
      'pilotProductClass',
      'pilotProductClassifiedAt',
      'pilotProductClassifiedByUid',
      'pilotProductClassificationRevision'
    ].concat(serverOwnedProductFields());
  }

  // Revision 28 admin client-SDK closure (§10.1 "Rules responsibility
  // boundary" — "a client can never create, alter, activate, approve,
  // revoke, or delete this field by any write Rules permit"): the
  // product `allow create`/`allow update` rules below historically OR'd
  // `isAdmin()` against `isSafeNewProductSubmission()`/
  // `isSafeProductResubmission()` — the only place
  // `serverOwnedProductFields()`'s own protection (which already covers
  // `pilotProductApproval`, above) is enforced. An authenticated admin
  // using the Firebase client SDK could therefore forge or overwrite
  // `pilotProductApproval` directly, bypassing the admin-only
  // `approvePilotProduct`/`revokePilotProductApproval` operations
  // entirely. These two helpers are AND-ed onto the full create/update
  // rules, outside the `isAdmin()` OR, mirroring the identical business-
  // level fix (above) — narrowly scoped to this one field only; every
  // other server-owned product field's own pre-existing admin-bypass
  // behavior is unrelated to and unchanged by this contract.
  function omitsPilotProductApprovalOnCreate(data) {
    return !('pilotProductApproval' in data);
  }

  function preservesPilotProductApprovalOnUpdate(incoming, existing) {
    return !incoming.diff(existing).affectedKeys().hasAny(['pilotProductApproval']);
  }

  // Product publication admin client-SDK closure: the product
  // `allow create`/`allow update` rules OR `isAdmin()` against
  // `isSafeNewProductSubmission()`/`isSafeProductResubmission()` — the
  // only place either function's own unconditional
  // `data.isActive == false && data.moderationStatus == 'pending_review'`
  // requirement is enforced. An authenticated admin using the Firebase
  // client SDK could therefore set `isActive: true` and/or
  // `moderationStatus: 'approved'` directly on any product — publishing
  // it to public read (`allow read`'s
  // `moderationStatus == 'approved' && isActive == true` branch) without
  // ever going through the admin-only `approvePilotProduct` Function
  // (no fingerprint check, no seller-activation check, no active-pilot-
  // count limit, no audit event) — while `pilotProductApproval` itself
  // (already closed above) stays untouched, leaving the product visibly
  // "published" with no corresponding approval record at all. This
  // predicate is AND-ed onto the full create/update rules, outside the
  // `isAdmin()` OR, mirroring `omitsPilotProductApprovalOnCreate`/
  // `preservesPilotProductApprovalOnUpdate`'s exact mechanism above: the
  // sole legitimate resulting publication state for ANY client-SDK
  // write, create or update, admin included, is the unpublished one —
  // `isActive: true`/`moderationStatus: 'approved'` is reachable only
  // via the Admin-SDK-only `approvePilotProduct` Function, which
  // bypasses Rules entirely and is therefore wholly unaffected by this
  // predicate. `request.resource.data` is always the complete resulting
  // document on both create and update (this file's own P0.1 history,
  // above), so the identical check applies unchanged to both — one
  // function, not two. Every other server-owned product field's own
  // pre-existing admin-bypass behavior is unrelated to and unchanged by
  // this predicate.
  function hasUnpublishedProductPublicationState(data) {
    return data.isActive == false && data.moderationStatus == 'pending_review';
  }

  // Admin client-SDK product-identity closure (docs/plans/marketplace_
  // p1a_compliance_review_implementation_plan_2026-08-21.md §0.17 Phase
  // 4 decision 10, "No admin SKU override exists or is authorized — SKU
  // immutability applies identically to every caller, with no admin
  // bypass path", restated at the SKU implementation layer: "no Rules
  // branch, no Admin SDK helper, and no callable in this revision's own
  // scope ever permits a SKU value to change... for any caller"; and
  // §10.1 "Product binding, exact", which requires
  // `marketplaceBusinessGenerationId` to become "immutable after create
  // exactly like SKU"). `isSafeProductResubmission()`'s own SKU/
  // businessId/createdAt/marketplaceBusinessGenerationId diff-based
  // immutability check is reached only through the non-admin branch of
  // `allow update`'s `(isAdmin() || isSafeProductResubmission())` OR —
  // an authenticated admin using the client SDK could therefore reassign
  // a product to a different business, forge its `createdAt`, mutate or
  // remove its `sku`, or mutate/remove its `marketplaceBusinessGenerationId`
  // (silently defeating the "an old product from an earlier business
  // generation cannot be approved" guarantee §10.1 itself names). This
  // predicate is AND-ed onto `allow update`, outside the `isAdmin()` OR,
  // so the identical immutability invariant applies to every client-SDK
  // actor — exactly the plan's own explicitly-frozen requirement for
  // these four fields specifically. Every other integrity concern
  // currently reachable only through `isSafeProductResubmission()`'s
  // non-admin branch (media cap, seller-activation gate, unknown-field
  // rejection, `productInputRevision`/`sellerRelationship` validation,
  // category safety, the pilot-approval bound-field content freeze) is
  // deliberately NOT included here: the seller-activation gate and media
  // cap are explicitly, textually confirmed elsewhere in this same plan
  // (§10.1 "Admin bypass, stated accurately") as a known, accepted,
  // pre-existing architectural fact — "not a defect this contract
  // introduces or is expected to close" — governed instead by §17 step
  // 21e's Admin/Functions writer audit (already performed and passed),
  // never by a Rules change; the remaining items have no explicit
  // admin-inclusive requirement anywhere in the plan and are left
  // untouched rather than guessed at.
  // Revision 34 — `pilotProductClass` is server-owned. A seller update must
  // leave it exactly as it found it: absent stays absent, and a present
  // value must be preserved byte-identically. A diff-based check is used
  // rather than a presence check so a server-written value carried forward
  // unchanged never fails, while adding, altering or removing it does.
  // Preservation is deliberately value-blind: it does not make an
  // unrecognised value valid, it only forbids the client from touching it.
  //
  // Revision 35 (§0.33) extends the same closure to the classification's
  // provenance metadata, for the same reason and by the same mechanism:
  // `pilotProductClassifiedAt`, `pilotProductClassifiedByUid` and
  // `pilotProductClassificationRevision` are written solely by
  // `setPilotProductClassification` (Admin SDK). Covering the revision
  // counter here is what stops a client forging classification history —
  // back-dating it, advancing it, or attributing a classification to
  // another admin — even while leaving the class value itself alone.
  //
  // Because this predicate is AND-ed onto `allow update` outside the
  // `(isAdmin() || isSafeProductResubmission())` authorization OR, it binds
  // every client-SDK actor including an authenticated admin, exactly as the
  // sibling `preservesPilotProductApprovalOnUpdate` does. Product create and
  // delete are already `if false` for all clients, so update is the only
  // client path these four fields are reachable from.
  function preservesPilotProductClassOnUpdate(incoming, existing) {
    return !incoming.diff(existing).affectedKeys().hasAny([
      'pilotProductClass',
      'pilotProductClassifiedAt',
      'pilotProductClassifiedByUid',
      'pilotProductClassificationRevision'
    ]);
  }

  function preservesProductIdentityOnUpdate(incoming, existing) {
    return !incoming.diff(existing).affectedKeys().hasAny([
      'sku', 'businessId', 'createdAt', 'marketplaceBusinessGenerationId'
    ]);
  }

  // Companion to preservesProductIdentityOnUpdate, above, for create:
  // `isSafeNewProductSubmission()`'s own generation-match `get()`-based
  // requirement (§10.1 "Product binding, exact") is likewise reached
  // only through the non-admin branch of `allow create`'s
  // `(isAdmin() || isSafeNewProductSubmission())` OR. An authenticated
  // admin using the client SDK could therefore create a product bound to
  // a missing, mistyped, or stale `marketplaceBusinessGenerationId` —
  // the same "Rules protect the client path" guarantee §10.1 states with
  // no seller-specific carve-out. AND-ed onto `allow create`, outside
  // the `isAdmin()` OR, for the identical reason.
  function hasValidProductGenerationBindingOnCreate(data) {
    return data.businessId is string
      && data.marketplaceBusinessGenerationId is string
      && data.marketplaceBusinessGenerationId == get(
        /databases/$(database)/documents/businesses/$(data.businessId)
      ).data.marketplaceBusinessGenerationId;
  }

  // Revision 29 (docs/plans/marketplace_p1a_compliance_review_
  // implementation_plan_2026-08-21.md §0.27 "Actor-independent Marketplace
  // product-integrity contract" — no-exception correction): every
  // Firebase client-SDK product create, admin included, must satisfy the
  // identical schema/media/seller-activation/business-existence/
  // productInputRevision/sellerRelationship/category contract a seller
  // already does — previously reachable only through the non-admin
  // branch of `allow create`'s `(isAdmin() || isSafeNewProductSubmission())`
  // OR. AND-ed onto `allow create`, outside that OR, alongside the four
  // already-closed predicates above (pilotProductApproval, publication
  // state, generation binding, and — on update — identity immutability).
  // `businessId is string` is checked once here (also implicitly required
  // by `hasActiveMarketplaceSellerActivation`'s own first clause) so this
  // function is safe to evaluate standalone, independent of evaluation
  // order. Superseded, not reaffirmed: the seller-activation gate here
  // reuses the identical `hasActiveMarketplaceSellerActivation` helper
  // already used by `isSafeNewProductSubmission()` — the §10.1 "Admin
  // bypass, stated accurately" carve-out this helper's own bypass once
  // stood behind is closed by this revision (§0.27 C); this is that
  // closure. Deliberately excluded: only the four predicates already
  // independently AND-ed elsewhere on this same rule (pilotProductApproval,
  // publication state, generation match, and — update-only — identity
  // immutability), never duplicated here.
  // Revision 29 (§0.27) residual correction: `name`/`price`/`stock`
  // validity is product-document integrity, not actor authorization —
  // it was originally left inside `isSafeNewProductSubmission()` only
  // (never duplicated here) on the mistaken premise that a check absent
  // from the plan's own enumerated gap list needed no admin-inclusive
  // closure. Revision 29's own governing principle is broader than that
  // enumerated list: every client-SDK actor, admin included, must
  // satisfy every product-integrity predicate, named or not. Moved here
  // (removed from `isSafeNewProductSubmission()`, not duplicated) so it
  // is enforced exactly once, for every actor, matching this function's
  // own established consolidation reasoning for every other check below.
  function hasSafeProductIntegrityOnCreate(data) {
    return data.name is string && data.name.size() > 0
      && data.price is number && data.price > 0
      && data.stock is int && data.stock >= 1
      && data.category is string
      && isKnownSafeProductCategory(data.category)
      && sellerCreateHasNoServerOwnedFields(data)
      && isValidTransitionalProductInputRevisionCreate(data)
      && isValidTransitionalSellerRelationshipCreate(data)
      && data.keys().hasOnly(productAllowedFields())
      && data.media is list
      && data.media.size() <= 20
      && hasActiveMarketplaceSellerActivation(data.businessId);
  }

  // Revision 29 (§0.27) residual correction: an existing `pilotProductApproval`
  // must be structurally well-formed enough for Rules to determine its
  // `active` state before any client-SDK update may proceed at all — not
  // merely before the bound-field freeze specifically applies. A prior
  // draft of `hasSafeProductIntegrityOnUpdate` (below) treated a
  // malformed `pilotProductApproval` (wrong type, missing/non-boolean
  // `active`) as equivalent to "inactive" for the bound-field freeze
  // only, which correctly denied bound-field edits but incorrectly
  // allowed every *other* edit to proceed against a document whose
  // approval state Rules cannot actually prove is inactive — a fail-open
  // gap, not the fail-closed posture Revision 29 requires. `true`
  // (absent) is the only case in which no approval-state fact is being
  // claimed at all — an ordinary, never-approved draft. Every other case
  // (present and well-formed, or present and malformed) requires an
  // explicit, provable shape before Rules will reason about it further;
  // a malformed shape proves nothing safely and is therefore denied
  // outright, unconditionally, for the whole update — not normalized,
  // not removed, not replaced, by any client-SDK actor, admin included.
  // The authorized remediation path remains exactly what it already is
  // for a well-formed active approval: an Admin-SDK-only operation
  // (Revision 28, unaffected by and unreachable from this Rules-only
  // correction) — no new remediation mechanism is introduced or implied.
  function hasWellFormedPilotProductApprovalIfPresent(data) {
    return !('pilotProductApproval' in data)
      || (
        data.pilotProductApproval is map
        && 'active' in data.pilotProductApproval
        && data.pilotProductApproval.active is bool
      );
  }

  // Revision 29 (§0.27), update-side companion to
  // hasSafeProductIntegrityOnCreate, above — every Firebase client-SDK
  // product update, admin included, must satisfy the identical schema/
  // media/seller-activation/productInputRevision/sellerRelationship/
  // category contract a seller already does, AND, no-exception (§0.27 D,
  // the single highest-severity closed item), the approved-product
  // bound-field content freeze: while the existing product carries an
  // active `pilotProductApproval`, no client-SDK actor — admin included —
  // may touch any field `pilotApprovalBoundFields()` names, re-derived
  // here byte-identical to the seller-side predicate immediately below
  // and to the server-side fingerprint input inside `approvePilotProduct`'s
  // own transaction (§10.1 "Frozen bound-field set, corrected"), never
  // re-guessed. A well-formed existing `pilotProductApproval` with
  // `active == false`, or its outright absence, is an ordinary editable
  // draft — the freeze OR-clause below passes trivially and no other
  // predicate here treats it specially. A malformed existing
  // `pilotProductApproval` (wrong type, missing/non-boolean `active`) is
  // NOT treated as equivalent to inactive: `hasWellFormedPilotProductApprovalIfPresent`,
  // AND-ed below, denies the entire update outright the moment the shape
  // cannot be proven — see that function's own comment for the fail-open
  // gap this residual correction closes and why silent normalization is
  // never acceptable. The authorized path back to an editable state, for
  // a genuinely well-formed active approval, remains exactly
  // `revokePilotProductApproval`/`unpublishPilotProductForRevision`
  // (Admin SDK, unaffected by and unreachable from this Rules-only
  // correction) — once either commits, the existing document's own
  // `isActive`/`moderationStatus` are already `false`/`'pending_review'`
  // and `pilotProductApproval.active` is already `false`, so the
  // following client edit's own bound-field check passes trivially, with
  // no separate Rules exception required. A malformed approval has no
  // such client-SDK remediation path at all — only direct Admin SDK
  // correction of the document restores client-SDK editability.
  function hasSafeProductIntegrityOnUpdate(incoming, existing) {
    return incoming.name is string && incoming.name.size() > 0
      && incoming.price is number && incoming.price > 0
      && incoming.stock is int && incoming.stock >= 1
      && incoming.category is string
      && isKnownSafeProductCategory(incoming.category)
      && sellerUpdateLeavesServerOwnedFieldsUntouched(incoming, existing)
      && isValidTransitionalProductInputRevisionUpdate(incoming, existing)
      && isValidTransitionalSellerRelationshipUpdate(incoming, existing)
      && incoming.keys().hasOnly(productAllowedFields())
      && incoming.media is list
      && incoming.media.size() <= 20
      && hasActiveMarketplaceSellerActivation(existing.businessId)
      // Fail-closed on a malformed existing approval, unconditionally,
      // for the entire update — see hasWellFormedPilotProductApprovalIfPresent's
      // own comment, above, for the exact reasoning.
      && hasWellFormedPilotProductApprovalIfPresent(existing)
      && (
        !('pilotProductApproval' in existing)
        || existing.pilotProductApproval.active != true
        || !incoming.diff(existing).affectedKeys().hasAny(pilotApprovalBoundFields())
      );
  }

  // Revision 28 (§10.1 "Frozen bound-field set, corrected"): the
  // exhaustive class-1 (approval-bound) `Product` field set, used
  // identically by the Rules-level structural predicate below and the
  // server-side fingerprint input inside `approvePilotProduct`'s own
  // transaction — exact correspondence, per the plan's own requirement.
  // `sku`/`businessId`/`createdAt` are deliberately excluded: each is
  // already immutable via its own separate, pre-existing predicate, so
  // no bound-field protection could ever fire for them in practice.
  function pilotApprovalBoundFields() {
    return [
      'name', 'description', 'price', 'currency', 'media',
      'category', 'brand', 'barcode', 'salePrice', 'kdvRate',
      'sellerRelationship'
    ];
  }

  // Marketplace Revision 41 §0.39 (Slice 7C) — the seller's MERCHANDISING
  // category allowlist, mirrored from add_product_page.dart's `categories`
  // map. It is a known-safe allowlist rather than a blacklist, so a renamed
  // or re-added "medicine"-style value cannot slip back in silently.
  //
  // The Health category and its Vitamins subcategory are REMOVED:
  // vitamins and supplements are permanently
  // outside the pilot (Revision 41 §D) and could never be classified,
  // approved or published, so accepting the write only produced listings
  // destined for rejection. Six subcategories are added so the six Group B
  // accessory classes and the non-biocidal litter class are describable at
  // all.
  //
  // This decides only what a seller may WRITE as descriptive text. It is
  // never authorization, and it never assigns or implies `pilotProductClass`
  // — that field stays server-owned and admin-written, enforced separately
  // below and unchanged by this list.
  function isKnownSafeProductCategory(category) {
    return category in [
      'Food > Dry Food', 'Food > Wet Food', 'Food > Treats',
      'Litter > Cat Litter',
      'Accessories > Collar', 'Accessories > Harness', 'Accessories > Leash',
      'Accessories > Clothing', 'Accessories > Bowl', 'Accessories > Bed',
      'Accessories > Carrier', 'Accessories > Grooming Tool',
      'Toys > Chew Toy', 'Toys > Interactive'
    ];
  }

  // Marketplace P1-A Slice 4.2 (docs/plans/marketplace_p1a_compliance_
  // review_implementation_plan_2026-08-21.md §9, Revision 5 correction
  // 30-33): productInputRevision's Phase A (dormant-compatibility)
  // transitional contract. The live Add Product write path
  // (add_product_page.dart, Product.toJson()) does not send this field
  // yet and performs a full-document set() with no merge on every create
  // AND edit, so this must tolerate absence on both create and update
  // while making adoption monotonic once the field appears, and making
  // deletion of an already-adopted value structurally impossible via any
  // client write. Phase B (Slice 4.9) tightens this to unconditional
  // presence — this is not that; do not weaken create/update below to
  // require presence before Slice 4.9's own, separate Rules change.
  function isValidProductInputRevisionValue(v) {
    // 9007199254740991 == Number.MAX_SAFE_INTEGER (2^53 - 1). `is int`
    // is false for a JS float like 1.0 (a Firestore double), which is
    // exactly the rejection the plan's create/update tables require for
    // "float/double, including 0.0".
    return v is int && v >= 0 && v < 9007199254740991;
  }

  // Marketplace P1-A Revision 7 correction 43 (docs/plans/marketplace_p1a_
  // compliance_review_implementation_plan_2026-08-21.md §9): sellerRelationship
  // joins the matching-field set as the fifth field. productInputRevision's
  // own +0/+1 invariant below is unchanged in shape — matchingChanged stays
  // a single boolean OR across all five fields, never a per-field count, so
  // multiple simultaneous matching-field changes (including a
  // sellerRelationship change alongside category/brand/barcode/sku) still
  // require exactly +1, never more.
  function productInputRevisionMatchingFields() {
    return ['category', 'brand', 'barcode', 'sku', 'sellerRelationship'];
  }

  // diff().affectedKeys() is already this file's established mechanism
  // for "which fields changed" (sellerUpdateLeavesServerOwnedFieldsUntouched
  // above) — it is safe against a key being absent on either side (never
  // throws), so it also safely and correctly covers every absent/null/
  // value transition for the four nullable-or-required matching fields
  // without a separate per-field access.
  function productInputRevisionMatchingFieldsChanged(incoming, existing) {
    return incoming.diff(existing).affectedKeys()
      .hasAny(productInputRevisionMatchingFields());
  }

  // Transitional create contract (§9 table): absent is allowed; present
  // must be the exact int 0; every other present value (nonzero,
  // negative, float, string, null, map, list, oversized) is rejected.
  function isValidTransitionalProductInputRevisionCreate(data) {
    return !('productInputRevision' in data)
      || (
        data.productInputRevision is int
        && data.productInputRevision == 0
      );
  }

  // Transitional update matrix (§9, cases A-E).
  //   A (absent -> absent): allowed unconditionally below, including a
  //     matching-field edit — an explicitly acknowledged, temporary
  //     dormant gap, not an oversight (§9).
  //   B (absent -> present): the missing old value is treated as
  //     baseline 0.
  //   C (present -> present): the full +0/+1 invariant.
  //   D (present -> absent) and E (any malformed present value) are
  //     never matched by either allowed branch below and therefore
  //     always fall through to reject. This is intentional: row D is
  //     the single most important row in the whole matrix — it is what
  //     stops an old, unmigrated client's full-document set() from
  //     silently deleting an adopted revision — and it must never gain
  //     an exception here.
  function isValidTransitionalProductInputRevisionUpdate(incoming, existing) {
    let matchingChanged =
      productInputRevisionMatchingFieldsChanged(incoming, existing);
    return (
        !('productInputRevision' in existing)
        && !('productInputRevision' in incoming)
      )
      || (
        !('productInputRevision' in existing)
        && ('productInputRevision' in incoming)
        && isValidProductInputRevisionValue(incoming.productInputRevision)
        && incoming.productInputRevision == (matchingChanged ? 1 : 0)
      )
      || (
        ('productInputRevision' in existing)
        && isValidProductInputRevisionValue(existing.productInputRevision)
        && ('productInputRevision' in incoming)
        && isValidProductInputRevisionValue(incoming.productInputRevision)
        && incoming.productInputRevision
          == existing.productInputRevision + (matchingChanged ? 1 : 0)
      );
  }

  // Marketplace P1-A Revision 7 correction 43/45 (docs/plans/marketplace_
  // p1a_compliance_review_implementation_plan_2026-08-21.md §9/§11,
  // §13.1 Slice 4.2 correction): sellerRelationship's own dormant
  // create/update contract, structurally identical in shape to
  // productInputRevision's own contract above, applied to this field
  // itself. It is a seller-owned matching input (not server-owned, not a
  // compliance output), closed to exactly the six SELLER_RELATIONSHIP
  // enum values, never defaulted or inferred. This section governs only
  // the field's own presence/absence/value legality; its contribution to
  // productInputRevision's required delta is handled entirely by
  // productInputRevisionMatchingFields() above — the two compose, neither
  // replaces the other.
  function isValidSellerRelationshipValue(v) {
    return v is string && v in [
      'brand_owner', 'manufacturer', 'authorized_distributor',
      'authorized_dealer', 'importer', 'reseller'
    ];
  }

  // Transitional create contract: absent is allowed (row A); present must
  // be one of the six exact enum values (row B); any other present value
  // is rejected (row E — malformed values are never accepted, dormant or
  // strict).
  function isValidTransitionalSellerRelationshipCreate(data) {
    return !('sellerRelationship' in data)
      || isValidSellerRelationshipValue(data.sellerRelationship);
  }

  // Transitional update matrix, sellerRelationship's own A-E:
  //   A (absent -> absent): allowed unconditionally below.
  //   B (absent -> valid enum): allowed — relationship adoption.
  //   C/C' (valid -> valid, same or different): allowed — whether this
  //     counts as a matching-field change (and therefore requires
  //     productInputRevision's own +1) is decided separately, by
  //     productInputRevisionMatchingFieldsChanged's diff-based comparison,
  //     not by this function.
  //   D (valid -> absent) and E (any malformed present value, on either
  //     side) are never matched by any branch below and therefore always
  //     fall through to reject — including the case where the EXISTING
  //     stored value is already malformed (a pre-existing data anomaly):
  //     the third branch requires the existing value to itself be valid,
  //     so a malformed existing value fails closed unconditionally,
  //     regardless of what the incoming write attempts (absent, valid, or
  //     also malformed) — never silently repaired, never allowed to be
  //     deleted. This mirrors isValidTransitionalProductInputRevisionUpdate's
  //     identical fail-closed-on-malformed-existing behavior exactly.
  function isValidTransitionalSellerRelationshipUpdate(incoming, existing) {
    return (
        !('sellerRelationship' in existing)
        && !('sellerRelationship' in incoming)
      )
      || (
        !('sellerRelationship' in existing)
        && ('sellerRelationship' in incoming)
        && isValidSellerRelationshipValue(incoming.sellerRelationship)
      )
      || (
        ('sellerRelationship' in existing)
        && isValidSellerRelationshipValue(existing.sellerRelationship)
        && ('sellerRelationship' in incoming)
        && isValidSellerRelationshipValue(incoming.sellerRelationship)
      );
  }

  // Revision 29 (§0.27) expression-budget consolidation, exact and
  // deliberate — not a weakening. Every check below that duplicated a
  // predicate now separately AND-ed onto `allow create` outside the
  // authorization OR (`hasSafeProductIntegrityOnCreate`, and the already-
  // existing `hasUnpublishedProductPublicationState`/
  // `hasValidProductGenerationBindingOnCreate`) has been removed from
  // this function — category safety, schema/unknown-field closure, media
  // shape/cap, seller activation, `productInputRevision`,
  // `sellerRelationship`, publication state, and, **residual correction**,
  // `name`/`price`/`stock` validity (moved into
  // `hasSafeProductIntegrityOnCreate` itself — an earlier draft of this
  // consolidation left these three inside this function only, on the
  // mistaken premise that a check absent from the plan's own enumerated
  // gap list needed no admin-inclusive closure; Revision 29's own
  // governing principle is broader than that list — every product-
  // integrity predicate, named or not, applies to every client-SDK
  // actor). Evaluating each of these twice per write (once here for the
  // seller path, once more in the actor-independent predicate every
  // write already pays regardless of which authorization branch
  // matched) is not merely wasteful: Firestore Rules enforces a hard
  // per-request expression-evaluation ceiling, and the two most
  // expensive checks here — `productAllowedFields()`'s ~65-element list
  // construction/`hasOnly()` comparison, and
  // `hasActiveMarketplaceSellerActivation()`'s three chained cross-
  // document field reads — duplicated across both the seller-only and
  // the new actor-independent predicate, reproducibly exceeded that
  // ceiling during this revision's own real emulator testing ("Unable
  // to evaluate the expression as the maximum of 1000 expressions to
  // evaluate has been reached"), for both seller and admin writes
  // alike. This function now checks only what is genuinely unique to
  // the seller authorization path: ownership. Every check removed here
  // is still enforced, exactly once, for every actor, by the actor-
  // independent predicates on `allow create` itself — nothing named by
  // any prior revision as a requirement is weakened, skipped, or made
  // actor-dependent again.
  function isSafeNewProductSubmission() {
    let data = request.resource.data;
    return data.businessId is string
      && isBusinessOwner(data.businessId);
  }

  // Revision 29 (§0.27) expression-budget consolidation — the identical
  // reasoning as isSafeNewProductSubmission's own comment, immediately
  // above, applied to update/resubmission. Every check that duplicated a
  // predicate now separately AND-ed onto `allow update` outside the
  // authorization OR (`hasSafeProductIntegrityOnUpdate`, and the already-
  // existing `hasUnpublishedProductPublicationState`/
  // `preservesProductIdentityOnUpdate`/`preservesPilotProductApprovalOnUpdate`)
  // has been removed: category safety, schema/unknown-field closure,
  // media shape/cap, seller activation, `productInputRevision`,
  // `sellerRelationship`, publication state, SKU/`businessId`/
  // `createdAt`/`marketplaceBusinessGenerationId` immutability (already
  // fully covered by `preservesProductIdentityOnUpdate`'s own diff-based
  // check against exactly these four fields), the approved-product
  // bound-field content freeze, and, **residual correction**,
  // `name`/`price`/`stock` validity (moved into
  // `hasSafeProductIntegrityOnUpdate` itself, identical reasoning as
  // `isSafeNewProductSubmission`'s own comment above). This function now
  // checks only what is genuinely unique to the seller authorization
  // path: ownership (`incoming.businessId == existing.businessId`
  // establishes which business's ownership `isBusinessOwner` must
  // verify). Every check removed here is still enforced, exactly once,
  // for every actor, by the actor-independent predicates on `allow
  // update` itself.
  function isSafeProductResubmission() {
    let incoming = request.resource.data;
    let existing = resource.data;
    return incoming.businessId == existing.businessId
      && isBusinessOwner(existing.businessId);
  }

  // Marketplace Revision 38 §0.36 B (Slice 7B) — CALLABLE-ONLY PUBLIC
  // DISCOVERY. The branch that permitted ANY caller to read a product merely
  // because it was `approved && isActive` is removed.
  //
  // Those two fields are persisted product state. They converge toward
  // compliance truth through the recompute and invalidation sweeps, but
  // between an evidence revocation, a policy change, a business-generation
  // change or a decision invalidation and the sweep that propagates it, they
  // still read "approved and active". Revision 30 §H named that interval, and
  // a Rules predicate over product fields cannot close it: Rules cannot
  // recompute a `decisionHash`, cannot compare the active policy pointer, and
  // cannot compare the business compliance epoch. Denormalized mirrors such
  // as `complianceEffectiveStatus`/`complianceValidUntil` would not close it
  // either — expiry alone is checkable against request time, revocation and
  // policy drift are not.
  //
  // Public discovery therefore runs through `getMarketplaceProductList`/
  // `Detail`/`Batch`, which evaluate the live predicate against authoritative
  // state at the instant of the request. Deliberately NO `get()` into the
  // compliance collections is introduced here as a substitute: a partial
  // Rules predicate would re-open exactly the interval this closes.
  //
  // What remains: an admin reads for moderation, and a business owner reads
  // products canonically owned by their OWN business in every moderation
  // state, for management. Admin-SDK and callable paths are unaffected by
  // Rules by construction.
  // `'businessId' in resource.data` precedes the type test deliberately: on a
  // `list` operation a document missing the field raises "Property businessId
  // is undefined on object" as an EVALUATION ERROR, which fails the entire
  // query rather than merely excluding that document. Presence-first keeps a
  // malformed sibling from denying an owner their whole catalogue.
  allow read: if isAdmin()
    || (
      'businessId' in resource.data &&
      resource.data.businessId is string &&
      isBusinessOwner(resource.data.businessId)
    );

  // Marketplace Revision 34 — direct client-SDK product creation is denied
  // unconditionally, for every actor: seller-owner, another authenticated
  // user, an unauthenticated caller, and an authenticated admin using the
  // client SDK alike. Products are created only by trusted server code
  // through `submitMarketplaceProduct` (Admin SDK, which bypasses Rules by
  // construction), which re-derives ownership, seller activation, the
  // generation binding and every value check below server-side.
  //
  // This mirrors the posture `allow delete: if false` already established
  // for this same collection in Revision 19, and closes the last path by
  // which a client could place a product document at a deterministic ID
  // without passing the server contract.
  //
  // The four create-only predicates that this rule previously AND-ed —
  // `omitsPilotProductApprovalOnCreate`, `hasUnpublishedProductPublication
  // State`, `hasValidProductGenerationBindingOnCreate` and
  // `hasSafeProductIntegrityOnCreate` — are deliberately RETAINED rather
  // than deleted. `hasUnpublishedProductPublicationState` is still reached
  // by `allow update`; the other three are now unreachable from Rules and
  // are kept as the frozen, executable specification of the create contract
  // that `submitMarketplaceProduct` must continue to satisfy, and so that
  // re-opening client create can never silently lose them. They are not
  // live security logic any more, and this comment is their record.
  allow create: if false;

  allow update: if (isAdmin() || isSafeProductResubmission())
    && preservesPilotProductClassOnUpdate(request.resource.data, resource.data)
    && preservesPilotProductApprovalOnUpdate(request.resource.data, resource.data)
    && hasUnpublishedProductPublicationState(request.resource.data)
    && preservesProductIdentityOnUpdate(request.resource.data, resource.data)
    && hasSafeProductIntegrityOnUpdate(request.resource.data, resource.data);

  // Marketplace P1-A Slice 4.10 (docs/plans/marketplace_p1a_compliance_
  // review_implementation_plan_2026-08-21.md §0.17 Phase 12, §9.E,
  // committed Revision 19): direct client-SDK product deletion is
  // denied unconditionally, admin included — the prior seller-owner and
  // admin branches are both removed, closing Gap B's own orphaning
  // mechanism (§0.12/§0.15) for every client caller, not only sellers.
  // A seller deletes their own product only through the new
  // `deleteMarketplaceProduct` callable (Admin SDK, bypasses Rules by
  // construction); no client-Rules-mediated admin bypass exists. This
  // mirrors the already-established, already-deployed posture for
  // `productComplianceDecisions`/`productEvidenceLinks`, both already
  // `allow create, update, delete: if false` unconditionally, admin
  // included.
  allow delete: if false;
}

    match /global_products/{productId} {
      allow read: if isRegisteredUser() || isAnonymousUser();
      allow write: if isAdmin();
    }

    match /global_product_aggregates/{aggregateId} {
      allow read: if isRegisteredUser() || isAnonymousUser();
      allow write: if isAdmin();
    }

    match /countries/{countryId} {

  allow read: if isSignedIn();
  allow write: if isAdmin();

  match /admin1/{admin1Id} {

    allow read: if isSignedIn();

    match /admin2/{admin2Id} {

      allow read: if isSignedIn();
    }
  }
}

    match /shipping_configs/{businessId} {
      allow read, create, update, delete: if isAdmin() || isBusinessOwner(businessId);
    }

    match /vet_tips/{tipId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      // The document may not exist yet for a new/free user. Path ownership is
      // therefore required in addition to the legacy data ownership check.
      allow read: if isAdmin() || (isSignedIn()
        && subscriptionId == request.auth.uid)
        || isSubscriptionOwner(resource.data);
      // Paid entitlement is backend-owned. End users can inspect their own
      // subscription but cannot grant, extend, replace, or delete it.
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || isNotificationOwner(resource.data);
      allow create: if isAdmin() || isNotificationOwner(request.resource.data);
      allow update, delete: if isAdmin() || isNotificationOwner(resource.data);
    }

    match /stories/{storyId} {
      allow read: if isRegisteredUser();

      allow create: if isRegisteredUser()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isRegisteredUser();

      allow delete: if isRegisteredUser()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      match /views/{viewerId} {
        allow read: if isRegisteredUser();
        allow create: if isRegisteredUser()
          && viewerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /story_likes/{likeId} {
      allow read: if isRegisteredUser();
      allow create: if isRegisteredUser()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isRegisteredUser();
      allow update: if false;
    }

    match /story_replies/{replyId} {
      allow read: if isRegisteredUser();
      allow create: if isRegisteredUser()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /followers/{userId}/userFollowers/{followerUserId} {
      allow read: if isRegisteredUser();
      allow create: if isRegisteredUser()
        && followerUserId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isRegisteredUser()
        && followerUserId == request.auth.uid;
      allow update: if false;
    }

    match /following/{userId}/userFollowing/{followingUserId} {
      allow read: if isRegisteredUser();
      allow create: if isRegisteredUser()
        && userId == request.auth.uid
        && request.resource.data.userId == followingUserId;
      allow delete: if isRegisteredUser()
        && userId == request.auth.uid;
      allow update: if false;
    }

    match /likes/{likeId} {
      allow read: if isAdmin() || isLikeOwner(resource.data);
      allow create: if isAdmin() || isLikeOwner(request.resource.data);
      allow update, delete: if isAdmin() || isLikeOwner(resource.data);
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isReviewOwner(request.resource.data) &&
        (
          request.resource.data.vetId is string ||
          request.resource.data.businessId is string
        )
      );
      allow update: if isAdmin() ||
        isReviewOwner(resource.data) ||
        (isSignedIn() && isReviewLikeOnlyUpdate());
      allow delete: if isAdmin() || isReviewOwner(resource.data);
    }

    match /playDateRequests/{requestId} {
      allow read: if isAdmin() || isPlayDateRequestParticipant(resource.data);
      allow create: if isAdmin() || isPlayDateRequestParticipant(request.resource.data);
      allow update, delete: if isAdmin() || isPlayDateRequestParticipant(resource.data);
    }

    match /playdate_reminders/{reminderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /adoption_requests/{requestId} {
      allow read: if isAdmin() || isAdoptionRequestParticipant(resource.data);
      allow create: if isAdmin() || isAdoptionRequestParticipant(request.resource.data);
      allow update, delete: if isAdmin() || isAdoptionRequestParticipant(resource.data);
    }

    match /business_requests/{requestId} {
      allow read: if isAdmin() || isBusinessRequestOwner(resource.data);
      allow create: if isAdmin() || (
        isBusinessRequestOwner(request.resource.data) &&
        (
          !('legal' in request.resource.data)
          || isValidOrAbsentCompanyType(request.resource.data.legal)
        )
      );
      allow update, delete: if isAdmin() || isBusinessRequestOwner(resource.data);
    }

    match /businessDrafts/{draftId} {
  allow read, write: if isRegisteredUser()
    && (
      isAdmin()
      || request.auth.uid == draftId
    );
}

    match /user_feedback/{feedbackId} {
      allow read: if isAdmin() || isFeedbackOwner(resource.data);
      allow create: if isAdmin() || isFeedbackOwner(request.resource.data);
      allow update, delete: if isAdmin() || isFeedbackOwner(resource.data);
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin() || isComplaintOwner(resource.data);
      allow create: if isAdmin() || isComplaintOwner(request.resource.data);
      allow update, delete: if isAdmin() || isComplaintOwner(resource.data);
    }

    match /reports/{reportId} {
      allow read: if isAdmin() ||
                     (isSignedIn() &&
                      resource.data.reporterId == request.auth.uid);

      // All writes must go through Cloud Functions (Admin SDK)
      allow write: if false;
    }

    match /scheduled_notifications/{notificationId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /email_otps/{emailId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /debug_tokens/{tokenId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /debug_reports/{reportId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admin_stats/{statId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admin_search_index/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /user_moderation_actions/{actionId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK only (warning/suspend/block/reactivate)
    }

    match /business_suspensions/{suspensionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || isOrderOwner(resource.data) || isBusinessOwner(resource.data.businessId);
      // Marketplace Revision 44 §0.42 (Slice 7E) — DIRECT CLIENT ORDER
      // CREATION IS CLOSED, for every sector and every actor.
      //
      // This previously allowed any signed-in caller to create an `orders`
      // document simply by naming themselves as the buyer. That let a client
      // author its own commercial record — order type, plan, seller identity,
      // pricing, payment status — and it was the reachable half of two
      // separate defects already recorded: the web-subscription underpayment
      // chain (Revision 42 §A) and the Marketplace acceptance gap
      // (Revision 39 §0.37 E).
      //
      // No client needs it. Every order-creating journey in the app already
      // goes through a trusted server callable that derives the commercial
      // values itself: `createMarketplaceOrderV2`, `createPetTaxiOrder`,
      // `createAppointmentOrder`, `createHotelBooking`,
      // `createGroomyAppointment`, `createVetAppointment`,
      // `createPromotionCheckout` and `createWebSubscriptionCheckout`. The
      // Admin SDK those callables use bypasses Rules, so closing this denies
      // only the client-SDK path — exactly as `sellerOrders` already does.
      //
      // An admin using the client SDK is denied too: privileged order
      // mutations belong to the trusted callables, not to a console session.
      allow create: if false;
      allow update, delete: if false;
    }

    match /sellerOrders/{sellerOrderId} {
      allow read: if isAdmin() || isOrderOwner(resource.data) || isSellerOrderBusinessOwner(resource.data);
      allow create, update, delete: if false;
    }

    // Immutable server-owned financial history. Admin SDK writes bypass
    // rules; clients may inspect it only as admins and can never mutate it.
    match /financialEvents/{eventId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    // Read-only payout projection. Canonical payout ownership remains on the
    // sector source collections; only trusted server code writes this index.
    match /payoutIndex/{payoutIndexId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    // Server-owned payout operation batches. Full banking details are
    // intentionally visible only to authorized admins.
    match /payoutBatches/{batchId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;

      match /items/{itemId} {
        allow read: if isFinanceViewer();
        allow create, update, delete: if false;
      }
    }

    match /financeLedger/{entryId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    match /financeAdjustments/{adjustmentId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    match /accountingPeriods/{periodId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    match /financeOperations/{documentId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    match /financeSellerAggregates/{aggregateId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    match /financeSavedFilters/{userId}/filters/{filterId} {
      allow read: if isFinanceViewer() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /sellerFinanceSummaries/{businessId} {
      allow read: if isFinanceViewer() || isBusinessOwner(businessId);
      allow create, update, delete: if false;

      match /{document=**} {
        allow read: if isFinanceViewer() || isBusinessOwner(businessId);
        allow create, update, delete: if false;
      }
    }

    match /order_returns/{returnId} {
      allow read: if isRegisteredUser() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        (
          resource.data.businessId is string &&
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerUid == request.auth.uid
        ) ||
        isAdmin()
      );

      allow create, update, delete: if false;
    }

    match /vet_appointments/{appointmentId} {
      allow read: if isRegisteredUser() && (
        isAppointmentOwner(resource.data) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      allow update: if isRegisteredUser() && (
        (
          isAppointmentOwner(resource.data) &&
          isStatusOnlyUpdate() &&
          canOwnerCancel(resource.data, request.resource.data)
        ) ||
        (
          (isBusinessOwner(resource.data.businessId) || isAdmin()) &&
          isStatusOnlyUpdate() &&
          canStaffUpdate(resource.data, request.resource.data)
        )
      );

      allow create, delete: if false;
    }
// ===============================
// 💬 CHATS
// ===============================
match /chats/{chatId} {

  allow get:
    if isAdmin()
    || isChatParticipant(resource.data)
    || isMissingCanonicalDirectChatLookup(chatId);

  allow list: if isRegisteredUser()
    && request.auth.uid in resource.data.participants;

  allow create: if isAdmin() || isValidDirectChatCreate(chatId);

  allow update: if isAdmin() || isValidChatParticipantUpdate();

  allow delete: if false;

  // ===============================
  // 💬 MESSAGES
  // ===============================
  match /messages/{messageId} {

    allow read: if isAdmin() || (
      isRegisteredUser()
      && request.auth.uid in get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data.participants
    );

    allow create: if isAdmin() || isValidChatMessageCreate(chatId);

    allow update: if isAdmin() || (isRegisteredUser()
      && request.auth.uid in get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data.participants
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']));

    allow delete: if false;
  }
}
match /business_chats/{chatId} {

  allow read, update:
      if isAdmin() || isBusinessChatParticipant(resource.data);

  allow create:
      if isAdmin() || isBusinessChatParticipant(request.resource.data);

  allow delete:
      if false;
}
match /business_chats/{chatId}/messages/{messageId} {

  allow read, update:
      if isAdmin() || isBusinessChatParticipant(
        get(/databases/$(database)/documents/business_chats/$(chatId)).data
      );

  allow create:
      if isAdmin()
      || (
        isBusinessChatParticipant(
          get(/databases/$(database)/documents/business_chats/$(chatId)).data
        )
        && request.resource.data.senderId == request.auth.uid
      );

  allow delete:
      if false;
}

match /vet_chats/{chatId} {

  allow read: if isAdmin() || isVetChatParticipant(resource.data);

  allow create: if isAdmin() || isVetChatParticipant(request.resource.data);

  allow update: if isAdmin() || isVetChatParticipant(resource.data);

  allow delete: if false;
}
    match /groomy_appointments/{appointmentId} {
      allow read: if isRegisteredUser() && (
        isAppointmentOwner(resource.data) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      allow update: if isRegisteredUser() && (
        (
          isAppointmentOwner(resource.data) &&
          isStatusOnlyUpdate() &&
          canOwnerCancel(resource.data, request.resource.data)
        ) ||
        (
          (isBusinessOwner(resource.data.businessId) || isAdmin()) &&
          isStatusOnlyUpdate() &&
          canGroomyStaffUpdate(resource.data, request.resource.data)
        )
      );

      allow create, delete: if false;
    }
    match /hotel_bookings/{bookingId} {
      allow read: if isRegisteredUser() && (
        isAppointmentOwner(resource.data) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      allow update: if isRegisteredUser() && (
        (
          isAppointmentOwner(resource.data) &&
          isStatusOnlyUpdate() &&
          canOwnerCancel(resource.data, request.resource.data)
        ) ||
        (
          (isBusinessOwner(resource.data.businessId) || isAdmin()) &&
          isStatusOnlyUpdate() &&
          canHotelStaffUpdate(resource.data, request.resource.data)
        )
      );

      allow create, delete: if false;
    }

    match /pet_taxi_bookings/{bookingId} {
      allow read: if isRegisteredUser() && (
        isAppointmentOwner(resource.data) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      allow create: if isAdmin() || (
  isRegisteredUser()
  && request.resource.data.userId == request.auth.uid
  && request.resource.data.status == 'pending'
  && request.resource.data.paymentMethod == 'in_app'
);

      allow update: if isRegisteredUser()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.businessId == resource.data.businessId
        && isPetTaxiStatusOnlyUpdate()
        && (
          (
            isAppointmentOwner(resource.data) &&
            canPetTaxiUserCancel(resource.data, request.resource.data)
          ) ||
          (
            (isBusinessOwner(resource.data.businessId) || isAdmin()) &&
            canPetTaxiStaffUpdate(resource.data, request.resource.data)
          ) ||
          (
            (isBusinessOwner(resource.data.businessId) || isAdmin()) &&
            canPetTaxiStaffProposePrice(resource.data, request.resource.data)
          )
        );

      allow delete: if false;
    }

    // ===============================
// 📸 SOCIAL POSTS
// ===============================

match /social_posts/{postId} {

  allow read: if (
      resource.data.visibility == 'public'
      && (!('published' in resource.data) || resource.data.published == true)
      && (!('moderationStatus' in resource.data)
        || resource.data.moderationStatus == 'active')
      && (!('isHidden' in resource.data)
        || resource.data.isHidden == false)
    )
    || isAdmin()
    || (isRegisteredUser() && resource.data.userId == request.auth.uid);

  allow create: if isRegisteredUser()
    && request.resource.data.userId == request.auth.uid;

  // commentCount is intentionally NOT client-writable under any condition:
  // post_comments uses auto-generated IDs, so this rule has no way to
  // discover which (if any) new comment document a given write is
  // supposed to pair with, and therefore cannot prove atomic coupling the
  // way the deterministic post_likes/{postId}_{uid} id lets it do for
  // likeCount. Comment creation and its counter increment are instead
  // handled together, transactionally, by the addSocialComment trusted
  // callable (functions/index.js), which writes via the Admin SDK and so
  // bypasses these rules entirely — the only path that can ever change
  // commentCount.
  allow update: if isAdmin()
    || (isRegisteredUser() && resource.data.userId == request.auth.uid)
    || (isRegisteredUser() && isSocialPostLikeCounterOnlyUpdate(postId));

  allow delete: if isRegisteredUser()
    && (
      resource.data.userId == request.auth.uid
      || isAdmin()
    );
}
match /green_memorials/{memorialId} {

  allow read: if true;

  allow create: if isRegisteredUser()
    && request.resource.data.ownerId == request.auth.uid;

  allow update, delete: if isRegisteredUser()
    && resource.data.ownerId == request.auth.uid;
}
match /post_likes/{likeId} {

  allow read: if isSignedIn();

  // Deterministic doc ID ("{postId}_{uid}") makes a like idempotent per
  // user/post and stops a client from creating multiple like documents
  // for the same post under different random IDs to inflate likeCount.
  // isAtomicLikeCreatePair/isAtomicLikeDeletePair additionally require
  // the paired social_posts.likeCount transition to happen in the same
  // commit, so this document can never be created/deleted standalone
  // either — see the block comment above isSocialPostLikeCounterOnlyUpdate.
  allow create: if isRegisteredUser()
    && request.resource.data.userId == request.auth.uid
    && isEligibleSocialPostId(request.resource.data.postId)
    && likeId == request.resource.data.postId + '_' + request.auth.uid
    && isAtomicLikeCreatePair(request.resource.data.postId);

  allow delete: if isAdmin()
    || (isRegisteredUser()
      && resource.data.userId == request.auth.uid
      && isAtomicLikeDeletePair(resource.data.postId));

  allow update: if false;
}
match /post_comments/{commentId} {

  allow read: if isSignedIn();

  // Comments are callable-only: post_comments uses auto-generated IDs, so
  // there is no deterministic path this rule (or the social_posts update
  // rule) could use to prove a given create is atomically paired with its
  // commentCount increment the way post_likes proves it for likes. Rather
  // than accept an unpaired/unproven counter mutation, comment creation
  // and its counter increment happen together, transactionally, in the
  // addSocialComment trusted callable (functions/index.js), which writes
  // via the Admin SDK and so is not subject to this rule at all.
  allow create: if false;

  // Author self-service delete is intentionally not offered while there
  // is no compensating commentCount decrement path (there is currently no
  // client delete UI either). Admin moderation deletes remain available;
  // a future self-service delete must be a callable that also decrements
  // commentCount in the same transaction, mirroring addSocialComment.
  allow delete: if isAdmin();

  allow update: if false;
}
match /saved_posts/{saveId} {

  allow read: if isRegisteredUser();

  allow create: if isRegisteredUser()
    && request.resource.data.userId == request.auth.uid;

  allow delete: if isRegisteredUser();

  allow update: if false;
}

match /stories/{storyId} {

  // READ
  allow read: if true;

  // CREATE
  allow create: if isRegisteredUser()
    && request.resource.data.userId
        == request.auth.uid;

  // UPDATE
  allow update: if isRegisteredUser();

  // DELETE
  allow delete: if isRegisteredUser()
    && (
      resource.data.userId
          == request.auth.uid
      || isAdmin()
    );

  // STORY VIEWS
  match /views/{viewerId} {

    allow read: if isRegisteredUser();

    allow create: if isRegisteredUser()
      && viewerId == request.auth.uid;

    allow update, delete: if false;
  }
}
    // ===============================
    // CENTRAL PROMOTION ENGINE
    // ===============================

    // Plans are safe configuration only. They are readable by signed-in and
    // anonymous clients for future plan presentation, but all writes belong
    // to the trusted backend/admin workflow. No client-supplied plan price is
    // authoritative.
    match /promotion_plans/{planId} {
      allow read: if isRegisteredUser() || isAnonymousUser();
      allow create, update, delete: if false;
    }

    // Campaign documents are financial and lifecycle truth. M2 intentionally
    // denies all client writes; Promotion callables and provider callbacks
    // use the Admin SDK for validated, idempotent transitions. Owners can
    // inspect only their own campaigns.
    match /promotion_campaigns/{campaignId} {
      allow read: if isAdmin()
        || (isRegisteredUser() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Public ranking projection contains no provider/payment data. It is
    // backend-owned and may be read by clients that can use public listings.
    match /promotion_active/{campaignId} {
      allow read: if isRegisteredUser() || isAnonymousUser();
      allow create, update, delete: if false;
    }

    // Promotion analytics are ingested and aggregated by trusted Functions.
    // Raw events are intentionally not client-readable or client-writable.
    match /promotion_events/{eventId} {
      allow read, create, update, delete: if false;
    }

    // Owners may read their own safe aggregate; all mutations remain backend-owned.
    match /promotion_campaign_stats/{campaignId} {
      allow read: if isAdmin()
        || (isRegisteredUser() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Trusted conversion attribution is an internal reconciliation ledger.
    // Campaign owners receive only the materialized stats read model.
    match /promotion_attributions/{attributionId} {
      allow read, create, update, delete: if false;
    }

    // Operational reconciliation cases are admin/server-only diagnostics.
    match /promotion_reconciliation_cases/{caseId} {
      allow read, create, update, delete: if false;
    }

    // =====================================================================
    // Marketplace P1-A compliance foundation (Slice 1)
    // (docs/audits/marketplace_p1_bulk_compliance_inventory_architecture_
    // 2026-08-21.md, docs/plans/marketplace_p1a_compliance_review_
    // implementation_plan_2026-08-21.md, §9/§16).
    //
    // Deny-by-default / server-write-only posture for every collection
    // below: no writer of any kind exists yet in this slice, so every
    // `create`/`update`/`delete` is unconditionally denied via Rules —
    // this is not a placeholder to be loosened casually later, it is the
    // explicit Slice 1 boundary. Later slices' Admin-SDK server
    // operations will write these collections directly; Admin SDK
    // bypasses these Rules entirely, so no `allow` clause here is ever
    // "for" the server — every read/write posture below describes only
    // what a signed-in client (seller or admin) may do.
    //
    // Read posture is deliberately conservative for three collections
    // (complianceUploadSessions, complianceDocuments,
    // complianceReviewEvents): each mixes fields that are safe for the
    // owning business to see with fields that are not (session/document
    // internals such as `storagePath`/`contentHash`/`scanResultRef`, or
    // admin-authored `notes` on a review event) — because Firestore reads
    // are document-level, not field-level, granting owner read here would
    // mean granting it to every field. Rather than expose those fields or
    // invent an un-reviewed field-level split, these three stay
    // admin-only in Slice 1; a seller-safe server-mediated projection
    // (omitting the sensitive fields) is left for a later slice, once a
    // real consuming UI exists to design it against.
    // =====================================================================

    match /businessInventoryPolicies/{businessId} {
      allow read: if isBusinessOwner(businessId) || isAdmin();
      allow create, update, delete: if false;
    }

    // Marketplace Revision 30 §J Slice 3 — the uploading business may read
    // its OWN intake state, and nothing else.
    //
    // §I's seller UI contract requires the seller to "see its status", and
    // requires state to survive navigation and an app restart; without that
    // read the screen cannot tell an in-flight upload from a fresh one and
    // would permit exactly the blind re-upload §I forbids. §G already fixes
    // who may see evidence — "the uploading business and reviewing admins"
    // — so this grants no audience the frozen plan had not already named.
    //
    // Scoped by the document's own server-written `businessId` through the
    // established `isBusinessOwner()` pattern this file already uses for
    // complianceDocumentScopes, productEvidenceLinks and
    // productComplianceDecisions. WRITES REMAIN DENIED to every client,
    // admin included: a seller can observe its intake, never author it.
    match /complianceUploadSessions/{sessionId} {
      allow read: if isAdmin() ||
        (resource.data.businessId is string && isBusinessOwner(resource.data.businessId));
      allow create, update, delete: if false;
    }

    match /complianceDocuments/{documentId} {
      allow read: if isAdmin() ||
        (resource.data.businessId is string && isBusinessOwner(resource.data.businessId));
      allow create, update, delete: if false;
    }

    // Slice 2 correction (adversarial review 2026-08-21, finding B) —
    // upload-session quota counters. Server-only in every respect: no
    // client of any kind (seller or admin) has any reason to read or
    // write these directly; the quota decision itself is surfaced to a
    // seller only as an HttpsError('resource-exhausted', ...) from
    // createComplianceUploadSession, never as document access.
    match /complianceUploadQuotaScopes/{scopeId} {
      allow read, create, update, delete: if false;
    }

    match /complianceUploadQuotaDaily/{dailyDocId} {
      allow read, create, update, delete: if false;
    }

    // Pre-Slice-7 correction — scheduler checkpoints, explicitly closed.
    //
    // Both documents are server-owned sweep cursors: the approval
    // invalidation sweep's continuation point (Slice 6) and the compliance
    // recompute sweep's (Slice 4.7). They were already unreachable, because
    // this file has no root `match /{document=**}` catch-all and Firestore
    // therefore default-denies an unmatched path — but that is an implicit
    // property of what is ABSENT from this file, and a future broad match
    // added elsewhere could silently grant access to a cursor that controls
    // which products get re-checked for revoked or expired evidence.
    //
    // Stated explicitly instead. `if false` denies every client actor
    // without exception — unauthenticated, customer, seller, business owner
    // and admin alike; an admin has no more reason to read a sweep cursor
    // than a stranger does. Admin SDK access from the Functions that own
    // these documents is unaffected, since Rules never apply to it.
    match /complianceApprovalInvalidationCheckpoint/{documentId} {
      allow read, write: if false;
    }

    match /complianceRecomputeSweepCheckpoint/{documentId} {
      allow read, write: if false;
    }

    match /complianceDocumentScopes/{scopeId} {
      allow read: if isAdmin() ||
        (resource.data.businessId is string && isBusinessOwner(resource.data.businessId));
      allow create, update, delete: if false;

      // Member documents carry no businessId of their own — ownership is
      // re-checked independently against the parent scope on every read,
      // never assumed from the parent match block above.
      match /members/{memberId} {
        allow read: if isAdmin() ||
          (
            get(/databases/$(database)/documents/complianceDocumentScopes/$(scopeId)).data.businessId is string &&
            isBusinessOwner(
              get(/databases/$(database)/documents/complianceDocumentScopes/$(scopeId)).data.businessId
            )
          );
        allow create, update, delete: if false;
      }
    }

    match /productEvidenceLinks/{linkId} {
      allow read: if isAdmin() ||
        (resource.data.businessId is string && isBusinessOwner(resource.data.businessId));
      allow create, update, delete: if false;
    }

    match /complianceReviewEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // No client read at all, admin included — mirrors the
    // promotion_reconciliation_cases precedent for a sensitive,
    // admin/server-only operational artifact. Sellers must never see
    // which evidence gaps exist to exploit them; admin's own access is
    // via a future dedicated, audited operation, not a raw document read.
    match /compliancePolicyRegistry/{registryVersion} {
      allow read, create, update, delete: if false;
    }

    match /productComplianceDecisions/{productId} {
      allow read: if isAdmin() ||
        (resource.data.businessId is string && isBusinessOwner(resource.data.businessId));
      allow create, update, delete: if false;
    }

    // Marketplace P1-A Step 21c2 (docs/plans/marketplace_p1a_compliance_
    // review_implementation_plan_2026-08-21.md §10.1 "Marketplace
    // seller-activation gate contract"): the immutable audit log for the
    // two authorized `grantMarketplaceSellerActivation`/
    // `revokeMarketplaceSellerActivation` operations. Deliberately a
    // narrow, dedicated collection — not `complianceReviewEvents`, whose
    // own `targetType`/`action` enum vocabulary (§10.1's own file-scope
    // inspection) is scoped to product-compliance-document review, a
    // different domain than business-level Marketplace seller
    // authorization; reusing it would require extending a shared,
    // product-compliance-specific enum with business-activation-specific
    // values, exactly the "overloading an existing field's meaning"
    // pattern this whole gate's own source audit already rejected once.
    // Mirrors `complianceReviewEvents`' own exact security posture:
    // admin-read-only, no client write of any kind, Admin SDK writes it
    // directly inside the same transaction as the state-object write.
    match /marketplaceSellerActivationAuditEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Revision 28 (§10.1 "Pilot Product Approval contract"): mirrors
    // `marketplaceSellerActivationAuditEvents`'s own exact
    // client-immutable posture — admin-read-only, no client write of
    // any kind, Admin SDK writes it directly inside the same
    // transaction as the corresponding `pilotProductApproval` state
    // write.
    // Marketplace Revision 34 — server-owned operational collections.
    // These are written only by trusted Functions through the Admin SDK,
    // which bypasses Rules by construction. They previously relied on
    // Firestore's implicit default-deny (no root catch-all match exists);
    // the explicit blocks below make that intent readable and prevent a
    // future rule from accidentally granting access through a broader
    // match. Admin SDK access is unaffected.
    match /marketplacePendingMediaCleanups/{cleanupId} {
      allow read, write: if false;
    }

    match /marketplaceBusinessDeletionCascades/{cascadeId} {
      allow read, write: if false;
    }

    match /marketplaceProductCleanupAuditEvents/{eventId} {
      allow read, write: if false;
    }

    match /marketplaceProductDeletionReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /pilotProductApprovalAuditEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Marketplace Revision 35 (§0.33) — the immutable classification audit
    // trail, written only by `setPilotProductClassification` inside the same
    // transaction as the state change it records. Identical posture to the
    // approval audit trail above: admins read it, no client-SDK actor may
    // ever create, alter or erase an entry.
    match /pilotProductClassificationAuditEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
