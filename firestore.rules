rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return isRegisteredUser();
    }

    function isAnonymousUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRegisteredUser() {
      return request.auth != null && !isAnonymousUser();
    }

    function isAdmin() {
      return isSignedIn()
        && 'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function financeRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isFinanceViewer() {
      return financeRole() in [
        'admin',
        'super_admin',
        'finance_viewer',
        'finance_operator',
        'finance_manager'
      ];
    }

    function isBusinessOwner(businessId) {

  return isSignedIn()

    && businessId is string

    && (

      get(
        /databases/$(database)/documents/businesses/$(businessId)
      ).data.ownerUid == request.auth.uid

      ||

      get(
        /databases/$(database)/documents/businesses/$(businessId)
      ).data.contact.email == request.auth.token.email

    );
}

    function isSellerOrderBusinessOwner(data) {
      return isSignedIn() && (
        (data.businessId is string && isBusinessOwner(data.businessId)) ||
        (data.shopId is string && isBusinessOwner(data.shopId)) ||
        data.sellerUid == request.auth.uid ||
        data.ownerUid == request.auth.uid
      );
    }

    function isOwnUserDoc(userId) {
      return isSignedIn() && userId is string && request.auth.uid == userId;
    }

    function isBusinessDocumentOwner(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    // Defense-in-depth against a tampered/unsupported legal.companyType on a
    // direct client create of businesses/{businessId} or business_requests
    // (registerBusiness, the trusted Cloud Function, is the authoritative
    // enforcement point for the full document-requirement matrix — see
    // functions/business/businessDocumentRequirements.js — this only
    // rejects an invalid enum value, it does not compute required
    // documents). companyType is optional at this layer (absent is
    // legacy-compatible); only an explicitly-set invalid value is rejected.
    function isValidOrAbsentCompanyType(legalData) {
      return !('companyType' in legalData)
        || legalData.companyType == null
        || legalData.companyType in [
          'sole_proprietorship',
          'limited_company',
          'joint_stock_company'
        ];
    }

    function isCanonicalBusinessOwner(businessId) {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/businesses/$(businessId)
        ).data.ownerUid == request.auth.uid;
    }

    function canOwnerUpdateBusinessDocument(businessId) {
      return isCanonicalBusinessOwner(businessId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status',
          'published',
          'verification',
          'trust',
          'riskFlags',
          'ownerUid',
          'createdAt'
        ]);
    }

    function isPublicBusiness(businessId) {
      return get(
        /databases/$(database)/documents/businesses_public/$(businessId)
      ).data.status == 'approved'
        && get(
          /databases/$(database)/documents/businesses_public/$(businessId)
        ).data.published == true
        && get(
          /databases/$(database)/documents/businesses/$(businessId)
        ).data.status == 'approved'
        && get(
          /databases/$(database)/documents/businesses/$(businessId)
        ).data.published == true;
    }

    function isChatParticipant(data) {
      return isRegisteredUser()
        && 'participants' in data
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function isValidDirectChatCreate(chatId) {
      return isRegisteredUser()
        && request.resource.data.keys().hasOnly([
          'chatId',
          'type',
          'participants',
          'participantMap',
          'participantNames',
          'participantPhotos',
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'unreadCount',
          'createdBy',
          'createdAt',
          'updatedAt',
          'schemaVersion'
        ])
        && (
          chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
          || !('lastSenderId' in request.resource.data)
        )
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && (
          !('chatId' in request.resource.data)
          || request.resource.data.chatId == chatId
        )
        && (
          !('type' in request.resource.data)
          || request.resource.data.type == 'direct'
        )
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && (
          !('createdBy' in request.resource.data)
          || request.resource.data.createdBy == request.auth.uid
        )
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1]))
        && request.resource.data.lastMessage == ''
        && (
          !('lastSenderId' in request.resource.data)
          || request.resource.data.lastSenderId == ''
        );
    }

    function isMissingCanonicalDirectChatLookup(chatId) {
      return isRegisteredUser()
        && !exists(/databases/$(database)/documents/chats/$(chatId))
        && (
          chatId.matches(request.auth.uid + '_.*')
          || chatId.matches('.*_' + request.auth.uid)
        );
    }

    function chatParticipantsUnchanged() {
      return request.resource.data.participants == resource.data.participants
        && (
          !('participantMap' in resource.data)
          || request.resource.data.participantMap == resource.data.participantMap
        )
        && (
          !('createdBy' in resource.data)
          || request.resource.data.createdBy == resource.data.createdBy
        )
        && (
          !('chatId' in resource.data)
          || request.resource.data.chatId == resource.data.chatId
        )
        && (
          !('type' in resource.data)
          || request.resource.data.type == resource.data.type
        )
        && (
          !('schemaVersion' in resource.data)
          || request.resource.data.schemaVersion == resource.data.schemaVersion
        );
    }

    function isValidChatParticipantUpdate() {
      return isChatParticipant(resource.data)
        && chatParticipantsUnchanged()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'participantNames',
            'participantPhotos',
            'lastMessage',
            'lastMessageAt',
            'lastSenderId',
            'unreadCount',
            'updatedAt'
          ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSenderId'])
          || request.resource.data.lastSenderId == request.auth.uid
          || request.resource.data.lastSenderId == ''
        );
    }

    function isValidChatMessageCreate(chatId) {
      return isRegisteredUser()
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.participants
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'messageId',
          'chatId',
          'senderId',
          'receiverId',
          'senderName',
          'text',
          'type',
          'createdAt',
          'seenBy'
        ])
        && (
          !('chatId' in request.resource.data)
          || request.resource.data.chatId == chatId
        )
        && (
          !('receiverId' in request.resource.data)
          || (
            request.resource.data.receiverId in get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants
            && request.resource.data.receiverId != request.auth.uid
          )
        );
    }

    function isBusinessChatParticipant(data) {
      return isRegisteredUser() && (
        ('participants' in data && data.participants is list
          && request.auth.uid in data.participants) ||
        ('clientUserId' in data && data.clientUserId == request.auth.uid) ||
        ('businessId' in data && data.businessId is string
          && isCanonicalBusinessOwner(data.businessId))
      );
    }

    function isVetChatParticipant(data) {
      return isRegisteredUser() && (
        ('participants' in data && data.participants is list
          && request.auth.uid in data.participants) ||
        ('clientUserId' in data && data.clientUserId == request.auth.uid) ||
        ('vetUserId' in data && data.vetUserId == request.auth.uid) ||
        ('businessId' in data && data.businessId is string
          && isCanonicalBusinessOwner(data.businessId))
      );
    }

    function isAppointmentOwner(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.buyerUid == request.auth.uid
      );
    }

    function canOwnerCancel(oldData, newData) {
      return oldData.status in ['pending', 'awaiting_payment', 'confirmed', 'confirmed_paid']
        && newData.status == 'cancelled_by_user';
    }

    function canStaffUpdate(oldData, newData) {
      return (
        (oldData.status == 'pending' && newData.status in ['awaiting_payment', 'confirmed', 'rejected']) ||
        (oldData.status == 'awaiting_payment' && newData.status in ['confirmed_paid', 'payment_expired']) ||
        (oldData.status == 'confirmed' && newData.status in ['completed', 'cancelled_by_vet', 'rejected']) ||
        (oldData.status == 'confirmed_paid' && newData.status == 'completed')
      );
    }

    function canGroomyStaffUpdate(oldData, newData) {
      return (
        (oldData.status == 'pending' && newData.status in ['awaiting_payment', 'confirmed', 'rejected']) ||
        (oldData.status == 'awaiting_payment' && newData.status in ['confirmed_paid', 'payment_expired', 'cancelled_by_groomy']) ||
        (oldData.status == 'confirmed' && newData.status in ['completed', 'cancelled_by_groomy', 'rejected']) ||
        (oldData.status == 'confirmed_paid' && newData.status in ['completed', 'cancelled_by_groomy'])
      );
    }

    function canHotelStaffUpdate(oldData, newData) {
      return (
        (oldData.status == 'pending' && newData.status in ['awaiting_payment', 'confirmed', 'rejected', 'cancelled_by_hotel']) ||
        (oldData.status == 'awaiting_payment' && newData.status in ['confirmed_paid', 'payment_expired', 'cancelled_by_hotel']) ||
        (oldData.status == 'confirmed' && newData.status in ['checked_in', 'completed', 'cancelled_by_hotel', 'rejected']) ||
        (oldData.status == 'confirmed_paid' && newData.status in ['checked_in', 'completed', 'cancelled_by_hotel']) ||
        (oldData.status == 'checked_in' && newData.status in ['completed', 'cancelled_by_hotel'])
      );
    }

    function canPetTaxiStaffUpdate(oldData, newData) {
      return (
        (oldData.status == 'pending' && newData.status == 'cancelled_by_business') ||
        (oldData.status == 'awaiting_user_payment' && newData.status == 'cancelled_by_business') ||
        (oldData.status == 'payment_failed' && newData.status == 'cancelled_by_business') ||
        (oldData.status == 'confirmed_paid' && newData.status in ['driver_on_the_way', 'cancelled_by_business']) ||
        (oldData.status == 'driver_on_the_way' && newData.status in ['arrived', 'cancelled_by_business']) ||
        (oldData.status == 'arrived' && newData.status in ['pet_picked_up', 'cancelled_by_business']) ||
        (oldData.status == 'pet_picked_up' && newData.status in ['on_trip', 'cancelled_by_business']) ||
        (oldData.status == 'on_trip' && newData.status in ['completed', 'cancelled_by_business'])
      );
    }

    function canPetTaxiStaffProposePrice(oldData, newData) {
      return oldData.status in ['pending', 'awaiting_user_payment', 'payment_failed']
        && newData.status == 'awaiting_user_payment'
        && newData.finalPrice is number
        && newData.finalPrice > 0
        && newData.finalPriceCurrency is string
        && newData.priceConfirmedBy == request.auth.uid;
    }

    function canPetTaxiUserCancel(oldData, newData) {
      return oldData.status in ['pending', 'awaiting_user_payment', 'payment_failed', 'driver_on_the_way']
        && newData.status == 'cancelled_by_user';
    }

    function isStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']);
    }

    function isPetTaxiStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'status',
        'updatedAt',
        'lastStatusChange',
        'finalPrice',
        'finalPriceCurrency',
        'priceConfirmedBy',
        'priceConfirmedAt',
        'userAcceptedPrice',
        'userAcceptedAt',
        'userRejectedPrice',
        'userRejectedAt',
        'paymentStatus',
        'paymentAmount',
        'paymentCurrency',
        'providerPayoutStatus',
        'providerPayoutAt'
      ]);
    }

    function isNotificationOwner(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.recipientUserId == request.auth.uid ||
        data.targetUserId == request.auth.uid ||
        data.fromUserId == request.auth.uid
      );
    }

    function isSubscriptionOwner(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.buyerUid == request.auth.uid
      );
    }

    function isOrderOwner(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.buyerUid == request.auth.uid
      );
    }

    function isPlayDateRequestParticipant(data) {
      return isSignedIn() && (
        data.requesterUserId == request.auth.uid ||
        data.requesterId == request.auth.uid ||
        data.requestedUserId == request.auth.uid ||
        data.targetUserId == request.auth.uid ||
        data.ownerId == request.auth.uid ||
        data.targetOwnerId == request.auth.uid
      );
    }

   function isAdoptionRequestParticipant(data) {

  return isSignedIn() && (

    data.requesterUserId == request.auth.uid ||

    data.requesterId == request.auth.uid ||

    data.ownerId == request.auth.uid ||

    data.targetUserId == request.auth.uid ||

    data.targetOwnerId == request.auth.uid ||

    (
      data.targetOwnerId is string &&
      isBusinessOwner(
        data.targetOwnerId
      )
    )

  );

}

match /adoption_pets/{petId} {

  allow read: if isSignedIn();

  allow create:
    if isSignedIn()
    && request.resource.data.businessId is string
    && isBusinessOwner(
      request.resource.data.businessId
    );

  allow update, delete:
    if isAdmin()
    || (
      isSignedIn()
      && resource.data.businessId is string
      && isBusinessOwner(
        resource.data.businessId
      )
    );
}

allow read: if isAdmin() || (

  isSignedIn() && (

    resource.data.requesterUserId
      == request.auth.uid ||

    (

      resource.data.businessId
          is string &&

      isBusinessOwner(
        resource.data.businessId
      )

    ) ||

    (

      resource.data.targetOwnerId
          is string &&

      isBusinessOwner(
        resource.data.targetOwnerId
      )

    )

  )

);

    function isBusinessRequestOwner(data) {
      return isSignedIn() && (
        data.uid == request.auth.uid ||
        data.ownerUid == request.auth.uid ||
        data.requesterId == request.auth.uid
      );
    }

    function isFeedbackOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isComplaintOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isLikeOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isReviewOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isReviewLikeOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['likes', 'likedBy']);
    }

    function isSocialPostEligibleForInteraction(data) {
      return data.visibility == 'public'
        && (!('published' in data) || data.published == true)
        && (!('moderationStatus' in data) || data.moderationStatus == 'active')
        && (!('isHidden' in data) || data.isHidden == false);
    }

    function priorSocialPostLikeCount() {
      return resource.data.likeCount is int ? resource.data.likeCount : 0;
    }

    // ── Atomic like/counter coupling ──────────────────────────────────
    // A bare "changed keys == likeCount, delta == +/-1" rule bounds the
    // SIZE of a write but proves nothing about whether it corresponds to
    // a real like/unlike: a malicious client could call
    // postRef.update({likeCount: increment(1)}) standalone, repeatedly,
    // with no post_likes document ever created. These helpers close that
    // gap by requiring the counter transition and the caller's own
    // deterministic post_likes/{postId}_{uid} existence transition to
    // happen in the SAME write/commit, verified from both sides:
    //   - the social_posts update rule checks the like doc's before/after
    //     existence via exists()/existsAfter();
    //   - the post_likes create/delete rule checks the counter's
    //     before/after value via get()/getAfter().
    // Both must independently agree for the batch to commit, so neither a
    // standalone counter write nor a standalone membership write (without
    // its paired counter change) can succeed.
    function likeMembershipExistsBefore(postId, uid) {
      return exists(/databases/$(database)/documents/post_likes/$(postId + '_' + uid));
    }

    function likeMembershipExistsAfter(postId, uid) {
      return existsAfter(/databases/$(database)/documents/post_likes/$(postId + '_' + uid));
    }

    function socialPostLikeCountBefore(postId) {
      let post = get(/databases/$(database)/documents/social_posts/$(postId)).data;
      return 'likeCount' in post && post.likeCount is int ? post.likeCount : 0;
    }

    function socialPostLikeCountAfter(postId) {
      let post = getAfter(/databases/$(database)/documents/social_posts/$(postId)).data;
      return 'likeCount' in post && post.likeCount is int ? post.likeCount : 0;
    }

    // Lets any eligible signed-in user bump a public post's own likeCount
    // by exactly +1/-1 through SocialPostService.toggleLike's batch,
    // requiring the same commit to create/delete their own deterministic
    // post_likes/{postId}_{uid} document — see the block comment above.
    function isSocialPostLikeCounterOnlyUpdate(postId) {
      return isSocialPostEligibleForInteraction(resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (
          (
            request.resource.data.likeCount == priorSocialPostLikeCount() + 1
            && !likeMembershipExistsBefore(postId, request.auth.uid)
            && likeMembershipExistsAfter(postId, request.auth.uid)
          ) ||
          (
            request.resource.data.likeCount == priorSocialPostLikeCount() - 1
            && likeMembershipExistsBefore(postId, request.auth.uid)
            && !likeMembershipExistsAfter(postId, request.auth.uid)
          )
        );
    }

    // The mirror-image check, evaluated from the post_likes side: a
    // create is only valid if the paired parent counter went up by
    // exactly 1 in the same commit; a delete only if it went down by 1.
    function isAtomicLikeCreatePair(postId) {
      return socialPostLikeCountAfter(postId) == socialPostLikeCountBefore(postId) + 1;
    }

    function isAtomicLikeDeletePair(postId) {
      return socialPostLikeCountAfter(postId) == socialPostLikeCountBefore(postId) - 1;
    }

    function isEligibleSocialPostId(postId) {
      return postId is string
        && postId.size() > 0
        && exists(/databases/$(database)/documents/social_posts/$(postId))
        && isSocialPostEligibleForInteraction(
          get(/databases/$(database)/documents/social_posts/$(postId)).data
        );
    }

    function ownerProfileEditableFields() {
      return [
        'ownerName',
        'ownerPhone',
        'emergencyContact',
        'emergencyPhone',
        'city',
        'district',
        'address'
      ];
    }

    function changedOwnerProfileKeysAreAllowed() {
      return !('ownerProfile' in request.resource.data)
        || !('ownerProfile' in resource.data)
        || !(resource.data.ownerProfile is map)
        || request.resource.data.ownerProfile
          .diff(resource.data.ownerProfile)
          .affectedKeys()
          .hasOnly(ownerProfileEditableFields());
    }

    function createdOwnerProfileKeysAreAllowed() {
      return !('ownerProfile' in request.resource.data)
        || (
          'ownerProfile' in resource.data
          && resource.data.ownerProfile is map
        )
        || (
          request.resource.data.ownerProfile is map
          && request.resource.data.ownerProfile.keys().hasOnly(ownerProfileEditableFields())
        );
    }

    function isOwnerProfileSnapshotUpdate() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'ownerProfile',
          'ownerProfileUpdatedAt',
          'updatedAt'
        ])
        && (
          !('ownerProfile' in request.resource.data)
          || request.resource.data.ownerProfile is map
        )
        && changedOwnerProfileKeysAreAllowed()
        && createdOwnerProfileKeysAreAllowed();
    }

    function protectedUserFields() {
      return [
        'uid',
        'userId',
        'ownerUid',
        'ownerId',
        'role',
        'admin',
        'isAdmin',
        'isPremium',
        'subscription',
        'subscriptions',
        'subscriptionPlan',
        'subscriptionStatus',
        'entitlement',
        'entitlements',
        'businessId',
        'businessOwnerUid',
        'creator'
      ];
    }

    function protectedUserCreateFields() {
      // 'isPremium' is intentionally excluded from this list. It is handled
      // separately by isLegacyIsPremiumFalseCreate() below: a narrow,
      // exact-`false`-only backward-compatibility exception for already-
      // released app versions whose signup payload still includes
      // `isPremium: false`. It is never permitted to be `true` on create,
      // and remains fully protected from any update — see
      // protectedUserFields()/selfUserUpdateFieldsAreAllowed below, which is
      // unchanged and still includes 'isPremium'.
      return [
        'userId',
        'ownerUid',
        'ownerId',
        'role',
        'admin',
        'isAdmin',
        'subscription',
        'subscriptions',
        'subscriptionPlan',
        'subscriptionStatus',
        'entitlement',
        'entitlements',
        'businessId',
        'businessOwnerUid',
        'creator'
      ];
    }

    // Backward compatibility for already-released clients: pre-fix versions
    // of buildSocialProfileCreationData() (lib/services/social_auth_service.dart)
    // send `isPremium: false` on initial profile creation, which used to be
    // unconditionally rejected by protectedUserCreateFields() — causing Auth
    // sign-in to succeed while the users/{uid} profile silently failed to be
    // created. Only an exact literal `false` is ever accepted here;
    // `isPremium: true` (or any other value) is always rejected. This
    // exception applies to document creation only — isPremium remains fully
    // update-protected via protectedUserFields()/selfUserUpdateFieldsAreAllowed.
    // Safe to remove once no released client version still sends isPremium on
    // signup (the fixed client omits it entirely, which this also permits).
    function isLegacyIsPremiumFalseCreate() {
      return !('isPremium' in request.resource.data)
        || request.resource.data.isPremium == false;
    }

    function selfUserCreateFieldsAreAllowed(userId) {
      return !request.resource.data.keys().hasAny(protectedUserCreateFields())
      && isLegacyIsPremiumFalseCreate()
      && (
        !('uid' in request.resource.data)
        || request.resource.data.uid == userId
      );
    }

    function selfUserUpdateFieldsAreAllowed() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(protectedUserFields());
    }

    function isOfferClickCountOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['clickCount']);
    }

    match /users/{userId} {
      allow read: if isOwnUserDoc(userId) || isAdmin();

      // SEC-1 fix (docs/architecture/creator-referral-engine.md, Finding
      // SEC-1 / Design Invariants): the `creator` map is server-authoritative
      // — only Cloud Functions (Admin SDK, which bypasses these rules) may
      // create, activate, deactivate, or otherwise write it. Neither the
      // document owner nor an admin acting through the client SDK may touch
      // it; admin creator actions must go through the dedicated callables
      // (createCreatorProfile / assignReferralCode / activateCreator /
      // deactivateCreator). Every other field on this document keeps its
      // existing self-or-admin write access, unchanged.
      allow create: if (
          (isOwnUserDoc(userId) && selfUserCreateFieldsAreAllowed(userId))
          || isAdmin()
        )
        && !('creator' in request.resource.data);
      allow update: if (
          (isOwnUserDoc(userId) && selfUserUpdateFieldsAreAllowed())
          || isAdmin()
        )
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creator']);
      allow delete: if isOwnUserDoc(userId) || isAdmin();

      // This nested wildcard is not purely a subcollection rule: when
      // {document=**} matches zero path segments it also matches the
      // parent users/{userId} document itself (Firestore rules OR-combine
      // every matching allow statement), so it must carry the exact same
      // SEC-1 restriction as the explicit rules above or it silently
      // re-opens the hole they close. Confirmed empirically with the
      // Firestore emulator: the initial version of this fix (restriction
      // above, unrestricted grant here) still let a self-write set
      // creator.enabled — this block was the reason why.
      match /{document=**} {
        allow read: if isOwnUserDoc(userId) || isAdmin();
        allow create: if (
            (isOwnUserDoc(userId) && selfUserCreateFieldsAreAllowed(userId))
            || isAdmin()
          )
          && !('creator' in request.resource.data);
        allow update: if (
            (isOwnUserDoc(userId) && selfUserUpdateFieldsAreAllowed())
            || isAdmin()
          )
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creator']);
        allow delete: if isOwnUserDoc(userId) || isAdmin();
      }
    }

    match /users_public/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // Creator Referral Engine — Sprint 3 attribution and qualification
    // foundation (see
    // docs/architecture/creator-referral-engine.md and
    // docs/SPRINT1_REPORT.md). Only this one collection is needed this
    // sprint; referralClicks / referralCampaigns / referralDailyStats remain
    // deferred to later sprints. Attribution and qualification writes are
    // Functions-only, including the pending -> qualified transition.
    match /referralCodes/{code} {
      // Public read: a future click-tracking/landing page must be able to
      // resolve a code's validity before the visitor has any account.
      allow read: if true;
      // Functions-only write (Admin SDK bypasses these rules) — assigned
      // exclusively by the assignReferralCode callable.
      allow write: if false;
    }

    match /referralAttributions/{referredUid} {
      // Referred users, the referring creator, and admins may inspect the
      // immutable record. Creation and all subsequent writes are Functions-only.
      allow read: if isSignedIn() && (
        request.auth.uid == referredUid
        || resource.data.creatorUid == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }

    match /creator_reward_ledger/{ledgerId} {
      // Creators may inspect their own immutable ledger. Only backend
      // qualification transactions may create or change ledger records.
      allow read: if isSignedIn() && (
        resource.data.creatorUid == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }

    match /dogs/{dogId} {

      function isDogOwner(data) {
        return isSignedIn() && (
          ('ownerId' in data && data.ownerId == request.auth.uid) ||
          ('ownerUid' in data && data.ownerUid == request.auth.uid)
        );
      }

      allow read:
        if isRegisteredUser()
        || (
          isAnonymousUser()
          && resource.data.isAvailableForAdoption == true
        );

      allow create:
        if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;

      allow update:
        if isAdmin() ||

        (
          isDogOwner(resource.data) &&

          request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'petName',
              'age',
              'healthStatus',
              'isNeutered',
              'description',
              'traits',
              'ownerGender',
              'imagePaths',
              'isAvailableForAdoption',
            ])
        ) ||

        (
          isDogOwner(resource.data) &&
          isOwnerProfileSnapshotUpdate()
        );

      allow delete:
        if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.ownerId == request.auth.uid
        );
    }

match /dogs/{dogId}/vaccines/{vaccineId} {

  allow read:
    if isSignedIn();

  allow create:
    if isAdmin() ||
    (
      isSignedIn() &&
      request.resource.data.businessId is string &&
      isBusinessOwner(
        request.resource.data.businessId
      )
    );

  allow update, delete:
    if isAdmin() ||
    (
    isSignedIn() &&
      resource.data.businessId is string &&
      isBusinessOwner(
        resource.data.businessId
      )
    );
}

match /dogs/{dogId}/visits/{visitId} {

  allow read: if isAdmin() || (
    isSignedIn() &&
    (
      get(
        /databases/$(database)/documents/dogs/$(dogId)
      ).data.ownerId == request.auth.uid ||

      resource.data.ownerId == request.auth.uid ||

      (
        resource.data.businessId is string &&
        isBusinessOwner(
          resource.data.businessId
        )
      )
    )
  );

  allow create: if isAdmin() || (
    isSignedIn() &&
    request.resource.data.businessId is string &&
    isBusinessOwner(
      request.resource.data.businessId
    )
  );

  allow update, delete: if isAdmin() || (
    isSignedIn() &&
    resource.data.businessId is string &&
    isBusinessOwner(
      resource.data.businessId
    )
  );
}
    match /lost_pets/{dogId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /found_pets/{dogId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
   }
    match /businesses/{businessId} {
      allow read: if isBusinessDocumentOwner(resource.data) || isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.published == false &&
        !request.resource.data.keys().hasAny([
          'verification',
          'trust',
          'riskFlags',
          'createdAt'
        ]) &&
        (
          !('legal' in request.resource.data)
          || isValidOrAbsentCompanyType(request.resource.data.legal)
        )
      );
      allow update: if isAdmin() || canOwnerUpdateBusinessDocument(businessId);
      allow delete: if isAdmin() || isCanonicalBusinessOwner(businessId);

      // Marketplace product compliance audit, P0 remediation (docs/audits/
      // marketplace_add_product_compliance_audit_2026-08-20.md): this
      // generic subcollection catch-all previously applied to `products`
      // too, since `{subcollection}` is an unconstrained wildcard — its
      // unconditional isCanonicalBusinessOwner() grant completely
      // bypassed the dedicated, hardened validation in the
      // `{path=**}/products/{productId}` match below (Firestore OR-combines
      // every matching rule, so the more permissive one always won).
      // `products` is carved out here and is governed exclusively by that
      // dedicated block. Every other existing subcollection (patients,
      // services, etc.) keeps its prior behavior unchanged.
      match /{subcollection}/{document=**} {
        allow read: if subcollection != 'products' &&
          (isCanonicalBusinessOwner(businessId) || isAdmin());
        allow create, update, delete:
          if subcollection != 'products' &&
          (isAdmin() || isCanonicalBusinessOwner(businessId));
      }
    }

    match /businesses_public/{businessId} {
      allow read: if true;
      allow write: if false;
    }

    match /businesses/{businessId}/services/{serviceId} {
      allow read: if isPublicBusiness(businessId);
      allow create, update, delete:
        if isAdmin() || isCanonicalBusinessOwner(businessId);
    }

    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && isOfferClickCountOnlyUpdate());
    }

    match /featured_deals/{dealId} {

  allow read: if isRegisteredUser() || isAnonymousUser();

  allow write: if isAdmin();

}

    match /{path=**}/products/{productId} {

  // Marketplace product compliance audit, P0 remediation
  // (docs/audits/marketplace_add_product_compliance_audit_2026-08-20.md,
  // findings F-02/F-03/F-07). Products are never self-approved or
  // self-published by a seller: every non-admin write is forced into
  // isActive == false / moderationStatus == 'pending_review', a fixed
  // known-safe category allowlist (fail-closed — no veterinary-medicine
  // option, no free-text bypass), an integer stock >= 1, and a lock on
  // every moderation/reservation field a seller must never touch. Public
  // reads only ever see approved + active products; a seller may still
  // read (but not publicly expose) their own pending/rejected products.

  // P0.1 correction (docs/audits/marketplace_p1_bulk_compliance_inventory_
  // architecture_2026-08-21.md, Revision 3 §6): request.resource.data is
  // ALWAYS the complete post-write document, not a diff — this is true on
  // update regardless of whether the client used set(), update(), or
  // set(merge:true). The original productProtectedKeysUntouched() checked
  // !data.keys().hasAny([blacklist]) against that complete document on
  // BOTH create and update. On create this is correct (a fresh submission
  // legitimately must not contain these keys at all). On update it is
  // wrong: the instant any Admin-SDK writer (functions/src/inventory/*)
  // sets one of these fields, EVERY subsequent seller edit's resulting
  // document still legitimately carries it forward unchanged — and the
  // bare presence check would reject that edit outright, permanently
  // locking the seller out of their own product, even though they never
  // touched the field. Harmless today only because the inventory module
  // is disabled in production (no real document has ever had these
  // fields set); would fire on the first canary activation.
  //
  // Fix: a server-owned field must be part of the closed document schema
  // (productAllowedFields()) so its mere presence never fails hasOnly(),
  // while its VALUE remains immutable to any seller write via a diff-based
  // unchanged-value check (sellerUpdateLeavesServerOwnedFieldsUntouched),
  // not a blacklist-style absence check. Create keeps a presence check
  // (sellerCreateHasNoServerOwnedFields) because there is no resource.data
  // to diff against yet — a fresh submission must omit these entirely.
  function serverOwnedProductFields() {
    return [
      // Already written today by functions/src/inventory/* (mirrors
      // SERVER_OWNED_INVENTORY_FIELDS in inventoryConstants.js) — inert
      // in production only because the M3/M5 feature flags are unset.
      'reservedStock',
      'inventorySchemaVersion',
      'inventoryOperationVersion',
      'inventoryUpdatedAt',
      // Reserved for a future admin-review write path; no code writes
      // these yet. Protected the same way now so activating that path
      // later cannot reintroduce this exact defect.
      'reviewedBy',
      'reviewedAt',
      'rejectionReason',
      'complianceStatus'
    ];
  }

  function sellerCreateHasNoServerOwnedFields(data) {
    return !data.keys().hasAny(serverOwnedProductFields());
  }

  function sellerUpdateLeavesServerOwnedFieldsUntouched(incoming, existing) {
    return !incoming.diff(existing).affectedKeys().hasAny(serverOwnedProductFields());
  }

  // P0 gap review: the exact, closed set of fields Product.toJson()
  // (lib/models/product.dart) ever writes, plus every server-owned field
  // above — every legitimate client write must be a subset of this list,
  // nothing more. This is the authoritative defense: an unknown field
  // (approved, published, publicationStatus, moderation, adminApproved,
  // inventoryOverride, customStatus, sellerUid, documentUrls, or anything
  // else not in this list) cannot be injected by any client write, admin
  // excepted. The seller-facing portion is kept in sync with toJson() by
  // construction — generated directly from it, not hand-guessed.
  function productAllowedFields() {
    return [
      'allowFreeShipping', 'allowPickup', 'allowReturns', 'allowSameDay',
      'allowedCarrierCodes', 'barcode', 'brand', 'businessId', 'businessLogo',
      'businessName', 'category', 'createdAt', 'currency', 'deliveryType',
      'description', 'excludedCities', 'fixedDesi', 'freeShippingThreshold',
      'hasContractedReturnCarrier', 'hasSmartPricing', 'heightCm', 'isActive',
      'isFragile', 'isOversize', 'isPerishable', 'isShippable', 'kdvRate',
      'lengthCm', 'marginPercent', 'markupPercent', 'maxDeliveryDays', 'media',
      'minStock', 'moderationStatus', 'name', 'originCity', 'preparationDays',
      'price', 'pricePosition', 'productId', 'returnCarrierCode',
      'returnShippingPayer', 'returnWindowDays', 'salePrice', 'shippingFee',
      'shippingMode', 'shippingPayer', 'shippingProfile', 'shippingSnapshot',
      'sku', 'stock', 'suggestedMaxPrice', 'suggestedMinPrice', 'suggestedPrice',
      'taxIncluded', 'updatedAt', 'weightKg', 'wholesalePrice', 'widthCm'
    ].concat(serverOwnedProductFields());
  }

  function isKnownSafeProductCategory(category) {
    return category in [
      'Food > Dry Food', 'Food > Wet Food', 'Food > Treats',
      'Accessories > Collar', 'Accessories > Leash', 'Accessories > Clothing',
      'Health > Vitamins',
      'Toys > Chew Toy', 'Toys > Interactive'
    ];
  }

  function isSafeNewProductSubmission() {
    let data = request.resource.data;
    return data.businessId is string
      && isBusinessOwner(data.businessId)
      && data.name is string && data.name.size() > 0
      && data.price is number && data.price > 0
      && data.stock is int && data.stock >= 1
      && data.category is string
      && isKnownSafeProductCategory(data.category)
      && data.isActive == false
      && data.moderationStatus == 'pending_review'
      && sellerCreateHasNoServerOwnedFields(data)
      && data.keys().hasOnly(productAllowedFields());
  }

  function isSafeProductResubmission() {
    let incoming = request.resource.data;
    let existing = resource.data;
    return incoming.businessId == existing.businessId
      && isBusinessOwner(existing.businessId)
      && incoming.name is string && incoming.name.size() > 0
      && incoming.price is number && incoming.price > 0
      && incoming.stock is int && incoming.stock >= 1
      && incoming.category is string
      && isKnownSafeProductCategory(incoming.category)
      && incoming.isActive == false
      && incoming.moderationStatus == 'pending_review'
      && sellerUpdateLeavesServerOwnedFieldsUntouched(incoming, existing)
      && incoming.keys().hasOnly(productAllowedFields())
      && !incoming.diff(existing).affectedKeys().hasAny([
        'businessId',
        'createdAt'
      ]);
  }

  allow read: if isAdmin()
    || (
      resource.data.moderationStatus == 'approved' &&
      resource.data.isActive == true
    )
    || (
      resource.data.businessId is string &&
      isBusinessOwner(resource.data.businessId)
    );

  allow create: if isAdmin() || isSafeNewProductSubmission();

  allow update: if isAdmin() || isSafeProductResubmission();

  allow delete:
    if isAdmin() ||
    (
      resource.data.businessId is string &&
      isBusinessOwner(resource.data.businessId)
    );
}

    match /global_products/{productId} {
      allow read: if isRegisteredUser() || isAnonymousUser();
      allow write: if isAdmin();
    }

    match /global_product_aggregates/{aggregateId} {
      allow read: if isRegisteredUser() || isAnonymousUser();
      allow write: if isAdmin();
    }

    match /countries/{countryId} {

  allow read: if isSignedIn();
  allow write: if isAdmin();

  match /admin1/{admin1Id} {

    allow read: if isSignedIn();

    match /admin2/{admin2Id} {

      allow read: if isSignedIn();
    }
  }
}

    match /shipping_configs/{businessId} {
      allow read, create, update, delete: if isAdmin() || isBusinessOwner(businessId);
    }

    match /vet_tips/{tipId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      // The document may not exist yet for a new/free user. Path ownership is
      // therefore required in addition to the legacy data ownership check.
      allow read: if isAdmin() || (isSignedIn()
        && subscriptionId == request.auth.uid)
        || isSubscriptionOwner(resource.data);
      // Paid entitlement is backend-owned. End users can inspect their own
      // subscription but cannot grant, extend, replace, or delete it.
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || isNotificationOwner(resource.data);
      allow create: if isAdmin() || isNotificationOwner(request.resource.data);
      allow update, delete: if isAdmin() || isNotificationOwner(resource.data);
    }

    match /stories/{storyId} {
      allow read: if isRegisteredUser();

      allow create: if isRegisteredUser()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isRegisteredUser();

      allow delete: if isRegisteredUser()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      match /views/{viewerId} {
        allow read: if isRegisteredUser();
        allow create: if isRegisteredUser()
          && viewerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /story_likes/{likeId} {
      allow read: if isRegisteredUser();
      allow create: if isRegisteredUser()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isRegisteredUser();
      allow update: if false;
    }

    match /story_replies/{replyId} {
      allow read: if isRegisteredUser();
      allow create: if isRegisteredUser()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /followers/{userId}/userFollowers/{followerUserId} {
      allow read: if isRegisteredUser();
      allow create: if isRegisteredUser()
        && followerUserId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isRegisteredUser()
        && followerUserId == request.auth.uid;
      allow update: if false;
    }

    match /following/{userId}/userFollowing/{followingUserId} {
      allow read: if isRegisteredUser();
      allow create: if isRegisteredUser()
        && userId == request.auth.uid
        && request.resource.data.userId == followingUserId;
      allow delete: if isRegisteredUser()
        && userId == request.auth.uid;
      allow update: if false;
    }

    match /likes/{likeId} {
      allow read: if isAdmin() || isLikeOwner(resource.data);
      allow create: if isAdmin() || isLikeOwner(request.resource.data);
      allow update, delete: if isAdmin() || isLikeOwner(resource.data);
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isReviewOwner(request.resource.data) &&
        (
          request.resource.data.vetId is string ||
          request.resource.data.businessId is string
        )
      );
      allow update: if isAdmin() ||
        isReviewOwner(resource.data) ||
        (isSignedIn() && isReviewLikeOnlyUpdate());
      allow delete: if isAdmin() || isReviewOwner(resource.data);
    }

    match /playDateRequests/{requestId} {
      allow read: if isAdmin() || isPlayDateRequestParticipant(resource.data);
      allow create: if isAdmin() || isPlayDateRequestParticipant(request.resource.data);
      allow update, delete: if isAdmin() || isPlayDateRequestParticipant(resource.data);
    }

    match /playdate_reminders/{reminderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /adoption_requests/{requestId} {
      allow read: if isAdmin() || isAdoptionRequestParticipant(resource.data);
      allow create: if isAdmin() || isAdoptionRequestParticipant(request.resource.data);
      allow update, delete: if isAdmin() || isAdoptionRequestParticipant(resource.data);
    }

    match /business_requests/{requestId} {
      allow read: if isAdmin() || isBusinessRequestOwner(resource.data);
      allow create: if isAdmin() || (
        isBusinessRequestOwner(request.resource.data) &&
        (
          !('legal' in request.resource.data)
          || isValidOrAbsentCompanyType(request.resource.data.legal)
        )
      );
      allow update, delete: if isAdmin() || isBusinessRequestOwner(resource.data);
    }

    match /businessDrafts/{draftId} {
  allow read, write: if isRegisteredUser()
    && (
      isAdmin()
      || request.auth.uid == draftId
    );
}

    match /user_feedback/{feedbackId} {
      allow read: if isAdmin() || isFeedbackOwner(resource.data);
      allow create: if isAdmin() || isFeedbackOwner(request.resource.data);
      allow update, delete: if isAdmin() || isFeedbackOwner(resource.data);
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin() || isComplaintOwner(resource.data);
      allow create: if isAdmin() || isComplaintOwner(request.resource.data);
      allow update, delete: if isAdmin() || isComplaintOwner(resource.data);
    }

    match /reports/{reportId} {
      allow read: if isAdmin() ||
                     (isSignedIn() &&
                      resource.data.reporterId == request.auth.uid);

      // All writes must go through Cloud Functions (Admin SDK)
      allow write: if false;
    }

    match /scheduled_notifications/{notificationId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /email_otps/{emailId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /debug_tokens/{tokenId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /debug_reports/{reportId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admin_stats/{statId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admin_search_index/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /user_moderation_actions/{actionId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK only (warning/suspend/block/reactivate)
    }

    match /business_suspensions/{suspensionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || isOrderOwner(resource.data) || isBusinessOwner(resource.data.businessId);
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.buyerUid == request.auth.uid ||
        request.resource.data.buyerEmail == request.auth.token.email
      ) && (
        request.resource.data.type != 'pet_taxi' ||
        (
          request.resource.data.status == 'pending' &&
          request.resource.data.paymentStatus == 'pending'
        )
      );
      allow update, delete: if false;
    }

    match /sellerOrders/{sellerOrderId} {
      allow read: if isAdmin() || isOrderOwner(resource.data) || isSellerOrderBusinessOwner(resource.data);
      allow create, update, delete: if false;
    }

    // Immutable server-owned financial history. Admin SDK writes bypass
    // rules; clients may inspect it only as admins and can never mutate it.
    match /financialEvents/{eventId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    // Read-only payout projection. Canonical payout ownership remains on the
    // sector source collections; only trusted server code writes this index.
    match /payoutIndex/{payoutIndexId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    // Server-owned payout operation batches. Full banking details are
    // intentionally visible only to authorized admins.
    match /payoutBatches/{batchId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;

      match /items/{itemId} {
        allow read: if isFinanceViewer();
        allow create, update, delete: if false;
      }
    }

    match /financeLedger/{entryId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    match /financeAdjustments/{adjustmentId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    match /accountingPeriods/{periodId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    match /financeOperations/{documentId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    match /financeSellerAggregates/{aggregateId} {
      allow read: if isFinanceViewer();
      allow create, update, delete: if false;
    }

    match /financeSavedFilters/{userId}/filters/{filterId} {
      allow read: if isFinanceViewer() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /sellerFinanceSummaries/{businessId} {
      allow read: if isFinanceViewer() || isBusinessOwner(businessId);
      allow create, update, delete: if false;

      match /{document=**} {
        allow read: if isFinanceViewer() || isBusinessOwner(businessId);
        allow create, update, delete: if false;
      }
    }

    match /order_returns/{returnId} {
      allow read: if isRegisteredUser() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        (
          resource.data.businessId is string &&
          get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerUid == request.auth.uid
        ) ||
        isAdmin()
      );

      allow create, update, delete: if false;
    }

    match /vet_appointments/{appointmentId} {
      allow read: if isRegisteredUser() && (
        isAppointmentOwner(resource.data) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      allow update: if isRegisteredUser() && (
        (
          isAppointmentOwner(resource.data) &&
          isStatusOnlyUpdate() &&
          canOwnerCancel(resource.data, request.resource.data)
        ) ||
        (
          (isBusinessOwner(resource.data.businessId) || isAdmin()) &&
          isStatusOnlyUpdate() &&
          canStaffUpdate(resource.data, request.resource.data)
        )
      );

      allow create, delete: if false;
    }
// ===============================
// 💬 CHATS
// ===============================
match /chats/{chatId} {

  allow get:
    if isAdmin()
    || isChatParticipant(resource.data)
    || isMissingCanonicalDirectChatLookup(chatId);

  allow list: if isRegisteredUser()
    && request.auth.uid in resource.data.participants;

  allow create: if isAdmin() || isValidDirectChatCreate(chatId);

  allow update: if isAdmin() || isValidChatParticipantUpdate();

  allow delete: if false;

  // ===============================
  // 💬 MESSAGES
  // ===============================
  match /messages/{messageId} {

    allow read: if isAdmin() || (
      isRegisteredUser()
      && request.auth.uid in get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data.participants
    );

    allow create: if isAdmin() || isValidChatMessageCreate(chatId);

    allow update: if isAdmin() || (isRegisteredUser()
      && request.auth.uid in get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data.participants
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']));

    allow delete: if false;
  }
}
match /business_chats/{chatId} {

  allow read, update:
      if isAdmin() || isBusinessChatParticipant(resource.data);

  allow create:
      if isAdmin() || isBusinessChatParticipant(request.resource.data);

  allow delete:
      if false;
}
match /business_chats/{chatId}/messages/{messageId} {

  allow read, update:
      if isAdmin() || isBusinessChatParticipant(
        get(/databases/$(database)/documents/business_chats/$(chatId)).data
      );

  allow create:
      if isAdmin()
      || (
        isBusinessChatParticipant(
          get(/databases/$(database)/documents/business_chats/$(chatId)).data
        )
        && request.resource.data.senderId == request.auth.uid
      );

  allow delete:
      if false;
}

match /vet_chats/{chatId} {

  allow read: if isAdmin() || isVetChatParticipant(resource.data);

  allow create: if isAdmin() || isVetChatParticipant(request.resource.data);

  allow update: if isAdmin() || isVetChatParticipant(resource.data);

  allow delete: if false;
}
    match /groomy_appointments/{appointmentId} {
      allow read: if isRegisteredUser() && (
        isAppointmentOwner(resource.data) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      allow update: if isRegisteredUser() && (
        (
          isAppointmentOwner(resource.data) &&
          isStatusOnlyUpdate() &&
          canOwnerCancel(resource.data, request.resource.data)
        ) ||
        (
          (isBusinessOwner(resource.data.businessId) || isAdmin()) &&
          isStatusOnlyUpdate() &&
          canGroomyStaffUpdate(resource.data, request.resource.data)
        )
      );

      allow create, delete: if false;
    }
    match /hotel_bookings/{bookingId} {
      allow read: if isRegisteredUser() && (
        isAppointmentOwner(resource.data) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      allow update: if isRegisteredUser() && (
        (
          isAppointmentOwner(resource.data) &&
          isStatusOnlyUpdate() &&
          canOwnerCancel(resource.data, request.resource.data)
        ) ||
        (
          (isBusinessOwner(resource.data.businessId) || isAdmin()) &&
          isStatusOnlyUpdate() &&
          canHotelStaffUpdate(resource.data, request.resource.data)
        )
      );

      allow create, delete: if false;
    }

    match /pet_taxi_bookings/{bookingId} {
      allow read: if isRegisteredUser() && (
        isAppointmentOwner(resource.data) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      allow create: if isAdmin() || (
  isRegisteredUser()
  && request.resource.data.userId == request.auth.uid
  && request.resource.data.status == 'pending'
  && request.resource.data.paymentMethod == 'in_app'
);

      allow update: if isRegisteredUser()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.businessId == resource.data.businessId
        && isPetTaxiStatusOnlyUpdate()
        && (
          (
            isAppointmentOwner(resource.data) &&
            canPetTaxiUserCancel(resource.data, request.resource.data)
          ) ||
          (
            (isBusinessOwner(resource.data.businessId) || isAdmin()) &&
            canPetTaxiStaffUpdate(resource.data, request.resource.data)
          ) ||
          (
            (isBusinessOwner(resource.data.businessId) || isAdmin()) &&
            canPetTaxiStaffProposePrice(resource.data, request.resource.data)
          )
        );

      allow delete: if false;
    }

    // ===============================
// 📸 SOCIAL POSTS
// ===============================

match /social_posts/{postId} {

  allow read: if (
      resource.data.visibility == 'public'
      && (!('published' in resource.data) || resource.data.published == true)
      && (!('moderationStatus' in resource.data)
        || resource.data.moderationStatus == 'active')
      && (!('isHidden' in resource.data)
        || resource.data.isHidden == false)
    )
    || isAdmin()
    || (isRegisteredUser() && resource.data.userId == request.auth.uid);

  allow create: if isRegisteredUser()
    && request.resource.data.userId == request.auth.uid;

  // commentCount is intentionally NOT client-writable under any condition:
  // post_comments uses auto-generated IDs, so this rule has no way to
  // discover which (if any) new comment document a given write is
  // supposed to pair with, and therefore cannot prove atomic coupling the
  // way the deterministic post_likes/{postId}_{uid} id lets it do for
  // likeCount. Comment creation and its counter increment are instead
  // handled together, transactionally, by the addSocialComment trusted
  // callable (functions/index.js), which writes via the Admin SDK and so
  // bypasses these rules entirely — the only path that can ever change
  // commentCount.
  allow update: if isAdmin()
    || (isRegisteredUser() && resource.data.userId == request.auth.uid)
    || (isRegisteredUser() && isSocialPostLikeCounterOnlyUpdate(postId));

  allow delete: if isRegisteredUser()
    && (
      resource.data.userId == request.auth.uid
      || isAdmin()
    );
}
match /green_memorials/{memorialId} {

  allow read: if true;

  allow create: if isRegisteredUser()
    && request.resource.data.ownerId == request.auth.uid;

  allow update, delete: if isRegisteredUser()
    && resource.data.ownerId == request.auth.uid;
}
match /post_likes/{likeId} {

  allow read: if isSignedIn();

  // Deterministic doc ID ("{postId}_{uid}") makes a like idempotent per
  // user/post and stops a client from creating multiple like documents
  // for the same post under different random IDs to inflate likeCount.
  // isAtomicLikeCreatePair/isAtomicLikeDeletePair additionally require
  // the paired social_posts.likeCount transition to happen in the same
  // commit, so this document can never be created/deleted standalone
  // either — see the block comment above isSocialPostLikeCounterOnlyUpdate.
  allow create: if isRegisteredUser()
    && request.resource.data.userId == request.auth.uid
    && isEligibleSocialPostId(request.resource.data.postId)
    && likeId == request.resource.data.postId + '_' + request.auth.uid
    && isAtomicLikeCreatePair(request.resource.data.postId);

  allow delete: if isAdmin()
    || (isRegisteredUser()
      && resource.data.userId == request.auth.uid
      && isAtomicLikeDeletePair(resource.data.postId));

  allow update: if false;
}
match /post_comments/{commentId} {

  allow read: if isSignedIn();

  // Comments are callable-only: post_comments uses auto-generated IDs, so
  // there is no deterministic path this rule (or the social_posts update
  // rule) could use to prove a given create is atomically paired with its
  // commentCount increment the way post_likes proves it for likes. Rather
  // than accept an unpaired/unproven counter mutation, comment creation
  // and its counter increment happen together, transactionally, in the
  // addSocialComment trusted callable (functions/index.js), which writes
  // via the Admin SDK and so is not subject to this rule at all.
  allow create: if false;

  // Author self-service delete is intentionally not offered while there
  // is no compensating commentCount decrement path (there is currently no
  // client delete UI either). Admin moderation deletes remain available;
  // a future self-service delete must be a callable that also decrements
  // commentCount in the same transaction, mirroring addSocialComment.
  allow delete: if isAdmin();

  allow update: if false;
}
match /saved_posts/{saveId} {

  allow read: if isRegisteredUser();

  allow create: if isRegisteredUser()
    && request.resource.data.userId == request.auth.uid;

  allow delete: if isRegisteredUser();

  allow update: if false;
}

match /stories/{storyId} {

  // READ
  allow read: if true;

  // CREATE
  allow create: if isRegisteredUser()
    && request.resource.data.userId
        == request.auth.uid;

  // UPDATE
  allow update: if isRegisteredUser();

  // DELETE
  allow delete: if isRegisteredUser()
    && (
      resource.data.userId
          == request.auth.uid
      || isAdmin()
    );

  // STORY VIEWS
  match /views/{viewerId} {

    allow read: if isRegisteredUser();

    allow create: if isRegisteredUser()
      && viewerId == request.auth.uid;

    allow update, delete: if false;
  }
}
    // ===============================
    // CENTRAL PROMOTION ENGINE
    // ===============================

    // Plans are safe configuration only. They are readable by signed-in and
    // anonymous clients for future plan presentation, but all writes belong
    // to the trusted backend/admin workflow. No client-supplied plan price is
    // authoritative.
    match /promotion_plans/{planId} {
      allow read: if isRegisteredUser() || isAnonymousUser();
      allow create, update, delete: if false;
    }

    // Campaign documents are financial and lifecycle truth. M2 intentionally
    // denies all client writes; Promotion callables and provider callbacks
    // use the Admin SDK for validated, idempotent transitions. Owners can
    // inspect only their own campaigns.
    match /promotion_campaigns/{campaignId} {
      allow read: if isAdmin()
        || (isRegisteredUser() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Public ranking projection contains no provider/payment data. It is
    // backend-owned and may be read by clients that can use public listings.
    match /promotion_active/{campaignId} {
      allow read: if isRegisteredUser() || isAnonymousUser();
      allow create, update, delete: if false;
    }

    // Promotion analytics are ingested and aggregated by trusted Functions.
    // Raw events are intentionally not client-readable or client-writable.
    match /promotion_events/{eventId} {
      allow read, create, update, delete: if false;
    }

    // Owners may read their own safe aggregate; all mutations remain backend-owned.
    match /promotion_campaign_stats/{campaignId} {
      allow read: if isAdmin()
        || (isRegisteredUser() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Trusted conversion attribution is an internal reconciliation ledger.
    // Campaign owners receive only the materialized stats read model.
    match /promotion_attributions/{attributionId} {
      allow read, create, update, delete: if false;
    }

    // Operational reconciliation cases are admin/server-only diagnostics.
    match /promotion_reconciliation_cases/{caseId} {
      allow read, create, update, delete: if false;
    }

    // =====================================================================
    // Marketplace P1-A compliance foundation (Slice 1)
    // (docs/audits/marketplace_p1_bulk_compliance_inventory_architecture_
    // 2026-08-21.md, docs/plans/marketplace_p1a_compliance_review_
    // implementation_plan_2026-08-21.md, §9/§16).
    //
    // Deny-by-default / server-write-only posture for every collection
    // below: no writer of any kind exists yet in this slice, so every
    // `create`/`update`/`delete` is unconditionally denied via Rules —
    // this is not a placeholder to be loosened casually later, it is the
    // explicit Slice 1 boundary. Later slices' Admin-SDK server
    // operations will write these collections directly; Admin SDK
    // bypasses these Rules entirely, so no `allow` clause here is ever
    // "for" the server — every read/write posture below describes only
    // what a signed-in client (seller or admin) may do.
    //
    // Read posture is deliberately conservative for three collections
    // (complianceUploadSessions, complianceDocuments,
    // complianceReviewEvents): each mixes fields that are safe for the
    // owning business to see with fields that are not (session/document
    // internals such as `storagePath`/`contentHash`/`scanResultRef`, or
    // admin-authored `notes` on a review event) — because Firestore reads
    // are document-level, not field-level, granting owner read here would
    // mean granting it to every field. Rather than expose those fields or
    // invent an un-reviewed field-level split, these three stay
    // admin-only in Slice 1; a seller-safe server-mediated projection
    // (omitting the sensitive fields) is left for a later slice, once a
    // real consuming UI exists to design it against.
    // =====================================================================

    match /businessInventoryPolicies/{businessId} {
      allow read: if isBusinessOwner(businessId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /complianceUploadSessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /complianceDocuments/{documentId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /complianceDocumentScopes/{scopeId} {
      allow read: if isAdmin() ||
        (resource.data.businessId is string && isBusinessOwner(resource.data.businessId));
      allow create, update, delete: if false;

      // Member documents carry no businessId of their own — ownership is
      // re-checked independently against the parent scope on every read,
      // never assumed from the parent match block above.
      match /members/{memberId} {
        allow read: if isAdmin() ||
          (
            get(/databases/$(database)/documents/complianceDocumentScopes/$(scopeId)).data.businessId is string &&
            isBusinessOwner(
              get(/databases/$(database)/documents/complianceDocumentScopes/$(scopeId)).data.businessId
            )
          );
        allow create, update, delete: if false;
      }
    }

    match /productEvidenceLinks/{linkId} {
      allow read: if isAdmin() ||
        (resource.data.businessId is string && isBusinessOwner(resource.data.businessId));
      allow create, update, delete: if false;
    }

    match /complianceReviewEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // No client read at all, admin included — mirrors the
    // promotion_reconciliation_cases precedent for a sensitive,
    // admin/server-only operational artifact. Sellers must never see
    // which evidence gaps exist to exploit them; admin's own access is
    // via a future dedicated, audited operation, not a raw document read.
    match /compliancePolicyRegistry/{registryVersion} {
      allow read, create, update, delete: if false;
    }

    match /productComplianceDecisions/{productId} {
      allow read: if isAdmin() ||
        (resource.data.businessId is string && isBusinessOwner(resource.data.businessId));
      allow create, update, delete: if false;
    }
  }
}
