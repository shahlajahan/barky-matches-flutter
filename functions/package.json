{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "node --check index.js && node --check subscription/webSubscriptionCore.js && node --check src/moderation/adminAuth.js && node --check src/moderation/businessSuspension.js && node --check src/moderation/targetRegistry.js",
    "test": "node --test test/*.test.js",
    "seed:commission": "node scripts/seedCommissionConfigs.js",
    "backfill:financial": "node scripts/backfillFinancialSnapshots.js",
    "backfill:invoice-deadlines": "node scripts/backfillInvoiceDeadlineState.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "@firebase/app": "^0.16.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/vision": "^5.3.4",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.5",
    "fluent-ffmpeg": "^2.1.3",
    "iyzipay": "^2.0.67",
    "nodemailer": "^7.0.5",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
