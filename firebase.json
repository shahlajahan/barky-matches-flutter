{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "functions": {
        "source": "functions"
    },
    "hosting": {
        "public": "build/web",
        "ignore": [
            "firebase.json",
            "**/.*",
            "!**/.well-known/**",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/isbank/3d-callback",
                "function": "isbank3DPayHostingCallback"
            },
            {
                "source": "/isbank/3d-success",
                "function": "isbank3DSuccessReturn"
            },
            {
                "source": "/isbank/3d-fail",
                "function": "isbank3DFailReturn"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "cleanUrls": true,
        "trailingSlash": false
    },
    "flutter": {
        "platforms": {
            "android": {
                "default": {
                    "projectId": "barkymatches-new",
                    "appId": "1:188282684447:android:66214fd7956b2e3553412a",
                    "fileOutput": "android/app/google-services.json"
                }
            },
            "ios": {
                "default": {
                    "projectId": "barkymatches-new",
                    "appId": "1:188282684447:ios:9be764f38d8f1a9c53412a",
                    "uploadDebugSymbols": false,
                    "fileOutput": "ios/Runner/GoogleService-Info.plist"
                }
            },
            "macos": {
                "default": {
                    "projectId": "barkymatches-new",
                    "appId": "1:188282684447:ios:c930439c183265a753412a",
                    "uploadDebugSymbols": false,
                    "fileOutput": "macos/Runner/GoogleService-Info.plist"
                }
            },
            "dart": {
                "lib/firebase_options.dart": {
                    "projectId": "barkymatches-new",
                    "configurations": {
                        "android": "1:188282684447:android:66214fd7956b2e3553412a",
                        "ios": "1:188282684447:ios:9be764f38d8f1a9c53412a",
                        "macos": "1:188282684447:ios:c930439c183265a753412a",
                        "web": "1:188282684447:web:2e04b07cfdc75dcc53412a",
                        "windows": "1:188282684447:web:35a399986880721553412a"
                    }
                }
            }
        }
    }
}
